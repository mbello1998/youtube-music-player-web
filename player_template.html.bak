<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Central de Músicas - Web Audio HD & Crossfade Spotify</title>
    <style>
        :root {
            --bg: #07080c;
            --surface: #10121b;
            --surface-hover: #181b28;
            --primary: #ff0055;
            --primary-gradient: linear-gradient(135deg, #ff0055, #ff5500);
            --accent: #00f2fe;
            --accent-glow: rgba(0, 242, 254, 0.4);
            --vlc-boost: #ffaa00;
            --vlc-max: #ff0055;
            --success: #00e676;
            --text: #ffffff;
            --text-dim: #9aa0a6;
            --border: #1e2233;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        
        /* BLOQUEIA SCROLLBAR EXTERNA DA PÁGINA (Layout fixo estilo Spotify Desktop) */
        html, body {
            height: 100vh;
            height: 100dvh;
            margin: 0;
            padding: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }
        
        /* CABEÇALHO SUPERIOR FIXO */
        .top-header-area {
            flex-shrink: 0;
            padding: 8px 20px 4px 20px;
            background: #080a10;
            border-bottom: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 6px;
            z-index: 20;
        }
        .header-main-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }
        .header-brand h1 {
            font-size: 19px;
            font-weight: 800;
            letter-spacing: -0.5px;
            background: linear-gradient(135deg, #fff 30%, var(--accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header-brand p {
            font-size: 11px;
            color: var(--text-dim);
        }
        
        /* NAVEGAÇÃO PRINCIPAL */
        .top-nav {
            display: flex;
            gap: 8px;
        }
        .nav-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 7px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 12.5px;
            font-weight: 600;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .nav-btn:hover {
            background: var(--surface-hover);
            color: var(--text);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .nav-btn.active {
            background: var(--primary-gradient);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 12px rgba(255, 0, 85, 0.35);
        }
        .queue-badge {
            background: rgba(0, 0, 0, 0.4);
            padding: 2px 7px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
        }

        /* ABAS DE CATEGORIAS COM AUTO-SCROLL NO HOVER */
        .tabs-nav-outer {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .tabs-wrapper {
            overflow-x: auto;
            scroll-behavior: smooth;
            width: 100%;
            scrollbar-width: none;
            -ms-overflow-style: none;
            padding: 2px 0;
        }
        .tabs-wrapper::-webkit-scrollbar {
            display: none;
        }
        .tabs {
            display: flex;
            gap: 8px;
            width: max-content;
        }
        .tabs-scroll-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: rgba(16, 18, 27, 0.95);
            border: 1px solid var(--border);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 5;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.6);
        }
        .tabs-scroll-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
        }
        .tabs-scroll-btn.left { left: -6px; }
        .tabs-scroll-btn.right { right: -6px; }
        .tab-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 6px 13px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .tab-btn:hover {
            background: var(--surface-hover);
            color: var(--text);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .tab-btn.active {
            background: rgba(0, 242, 254, 0.12);
            color: var(--accent);
            border-color: var(--accent);
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.25);
        }
        .count-badge {
            background: rgba(255, 255, 255, 0.1);
            color: inherit;
            padding: 1px 6px;
            border-radius: 8px;
            font-size: 10.5px;
        }
        
        /* CONTAINER PRINCIPAL DIVIDIDO */
        .main-container {
            flex: 1;
            display: flex;
            overflow: hidden;
            position: relative;
        }
        
        /* PAINEL FIXO DO PLAYER (À ESQUERDA - SEM ROLAGEM, SEM SCROLLBAR) */
        .player-pane {
            width: 380px;
            flex-shrink: 0;
            background: #090b12;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 8px 12px;
            gap: 5px;
            z-index: 10;
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.12) transparent;
        }
        .player-pane::-webkit-scrollbar {
            width: 4px;
        }
        .player-pane::-webkit-scrollbar-track {
            background: transparent;
        }
        .player-pane::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        .player-pane::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }
        .player-wrapper {
            display: flex;
            flex-direction: column;
            gap: 8px;
            width: 100%;
            height: 100%;
        }
        
        /* DECK DE VÍDEO & VISUALIZADOR HD */
        .video-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.7);
            border: 1px solid var(--border);
            flex-shrink: 0;
        }
        .deck-player {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            transition: opacity 0.3s ease;
        }
        
        /* TELA VISUALIZADOR ÁUDIO HD (SPOTIFY STYLE) */
        .visualizer-screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, #141829 0%, #06070e 100%);
            z-index: 5;
            overflow: hidden;
            transition: opacity 0.3s ease;
        }
        .vis-bg-blur {
            position: absolute;
            top: -20%;
            left: -20%;
            width: 140%;
            height: 140%;
            background-size: cover;
            background-position: center;
            filter: blur(28px) brightness(0.25);
            opacity: 0.8;
            z-index: 1;
        }
        .vis-content {
            position: relative;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            width: 100%;
            padding: 6px 12px;
        }
        .vis-art-wrapper {
            position: relative;
            width: 86px;
            height: 86px;
        }
        .vis-art-img {
            width: 100%;
            height: 100%;
            border-radius: 10px;
            object-fit: cover;
            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.8), 0 0 16px rgba(0, 242, 254, 0.25);
            border: 2px solid rgba(255, 255, 255, 0.12);
            transition: transform 0.3s ease;
        }
        .vis-art-img.pulse {
            animation: visPulse 2.4s ease-in-out infinite;
        }
        @keyframes visPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.04); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.9), 0 0 22px rgba(255, 0, 85, 0.4); }
        }
        .vis-canvas {
            width: 100%;
            height: 38px;
            display: block;
        }
        .vis-mode-tag {
            position: absolute;
            top: 7px;
            right: 7px;
            z-index: 3;
            font-size: 9px;
            font-weight: 800;
            color: var(--accent);
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 242, 254, 0.35);
            padding: 2px 7px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .vis-mode-tag .dot {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: #00e676;
            box-shadow: 0 0 8px #00e676;
            animation: blinkDot 1.4s infinite alternate;
        }
        @keyframes blinkDot {
            0% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        /* INDICADOR DE CROSSFADE */
        .crossfade-indicator {
            display: none;
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.18), rgba(255, 0, 85, 0.18));
            border: 1px solid var(--accent);
            color: #fff;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            text-align: center;
            animation: pulseFade 1.2s infinite;
        }
        @keyframes pulseFade {
            0%, 100% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.01); }
        }

        /* INFORMAÇÕES DA FAIXA EM REPRODUÇÃO NO PAINEL ESQUERDO */
        .current-track-info {
            display: flex;
            flex-direction: column;
            gap: 3px;
            background: var(--surface);
            padding: 9px 12px;
            border-radius: 10px;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }
        .current-track-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #fff;
            line-height: 1.25;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .current-track-artist {
            font-size: 11.5px;
            color: var(--text-dim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .track-status-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 2px;
        }
        .badge-source {
            font-size: 10px;
            font-weight: 600;
            color: var(--accent);
            background: rgba(0, 242, 254, 0.12);
            padding: 1px 7px;
            border-radius: 8px;
            border: 1px solid rgba(0, 242, 254, 0.25);
        }
        .now-playing-pill {
            font-size: 10px;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* CARD DESTAQUE: PRÓXIMA MÚSICA QUE VAI SER TOCADA */
        .next-track-preview-box {
            background: rgba(255, 170, 0, 0.08);
            border: 1px solid rgba(255, 170, 0, 0.35);
            border-radius: 10px;
            padding: 7px 11px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            flex-shrink: 0;
        }
        .next-preview-label {
            font-size: 9.5px;
            font-weight: 800;
            color: #ffaa00;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .next-preview-title {
            font-size: 12px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .next-preview-artist {
            font-size: 10.5px;
            color: var(--text-dim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn-radio-now {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(255, 0, 85, 0.15));
            border: 1px solid var(--accent);
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 5px 8px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex: 1;
            min-width: 0;
            width: auto;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .btn-radio-now:hover {
            background: var(--primary-gradient);
            border-color: transparent;
            box-shadow: 0 4px 14px rgba(255, 0, 85, 0.35);
        }

        .actions-grid {
            display: flex;
            gap: 6px;
            flex-shrink: 0;
        }
        .btn-action {
            flex: 1;
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 5px 8px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 600;
            text-align: center;
            text-decoration: none;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            white-space: nowrap;
        }
        .btn-action:hover {
            background: var(--surface-hover);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .btn-action.btn-queue {
            background: linear-gradient(135deg, rgba(255, 0, 85, 0.15), rgba(255, 85, 0, 0.15));
            border-color: var(--primary);
            color: #fff;
        }

        /* TOAST NOTIFICAÇÃO */
        .toast-notify {
            display: none;
            background: rgba(16, 20, 32, 0.96);
            border: 1px solid var(--accent);
            color: #fff;
            padding: 6px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            text-align: center;
            box-shadow: 0 4px 16px rgba(0,0,0,0.7);
            animation: fadeIn 0.2s ease;
            flex-shrink: 0;
        }

        /* PAINEL DE LISTAS À DIREITA: O ÚNICO QUE ROLA */
        .list-pane {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: var(--bg);
            position: relative;
        }
        .pane-view {
            display: flex;
            flex-direction: column;
            height: 100%;
            overflow: hidden;
        }
        .pane-fixed-header {
            flex-shrink: 0;
            padding: 10px 20px 6px 20px;
            background: var(--bg);
            border-bottom: 1px solid var(--border);
            z-index: 5;
        }
        .search-input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .search-input-field {
            width: 100%;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 8px 36px 8px 34px;
            color: #fff;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }
        .search-input-field:focus {
            border-color: var(--accent);
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.25);
        }
        .search-icon {
            position: absolute;
            left: 12px;
            color: var(--text-dim);
            font-size: 13px;
            pointer-events: none;
        }
        .btn-clear-search {
            position: absolute;
            right: 12px;
            background: transparent;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 12px;
            padding: 4px;
        }
        .search-badge {
            position: absolute;
            right: 32px;
            font-size: 11px;
            color: var(--accent);
            font-weight: 600;
        }

        /* LISTA DE MÚSICAS: ÚNICA BARRA DE ROLAGEM VERTICAL */
        .track-list {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 10px 20px 90px 20px;
            display: flex;
            flex-direction: column;
            gap: 7px;
            scroll-behavior: smooth;
        }
        .track-list::-webkit-scrollbar {
            width: 7px;
        }
        .track-list::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.2);
        }
        .track-list::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 4px;
        }
        .track-list::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }

        /* CARDS DE MÚSICA */
        .track-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 9px 14px;
            border-radius: 10px;
            transition: all 0.2s ease;
            position: relative;
        }
        .track-card:hover {
            background: var(--surface-hover);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateX(3px);
        }
        
        /* DESTAQUE: MÚSICA TOCANDO AGORA */
        .track-card.playing-now {
            background: linear-gradient(135deg, rgba(255, 0, 85, 0.18), rgba(0, 242, 254, 0.12));
            border-color: var(--primary);
            box-shadow: 0 0 16px rgba(255, 0, 85, 0.35);
        }
        
        /* DESTAQUE: PRÓXIMA MÚSICA A SER TOCADA */
        .track-card.next-up {
            background: rgba(255, 170, 0, 0.08);
            border-color: rgba(255, 170, 0, 0.45);
        }

        /* ANIMAÇÃO DE ADIÇÃO À PLAYLIST (SUMIR SUAVEMENTE DA LISTA) */
        .track-card.card-fly-out {
            transform: translateX(65px) scale(0.92);
            opacity: 0;
            max-height: 0;
            padding-top: 0;
            padding-bottom: 0;
            margin-top: 0;
            margin-bottom: 0;
            border: none;
            transition: all 0.38s cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: none;
        }
        
        .track-meta {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 3px;
            cursor: pointer;
            overflow: hidden;
        }
        .track-card-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .track-card.playing-now .track-card-title {
            color: var(--accent);
        }
        .track-card-artist {
            font-size: 11.5px;
            color: var(--text-dim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        
        /* BADGES DE STATUS DENTRO DO CARD */
        .badge-now-playing {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: var(--primary-gradient);
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            padding: 3px 7px;
            border-radius: 5px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }
        .badge-next-up {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: rgba(255, 170, 0, 0.22);
            color: #ffaa00;
            border: 1px solid rgba(255, 170, 0, 0.5);
            font-size: 9.5px;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 5px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }
        .badge-added-now {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: linear-gradient(135deg, rgba(0, 230, 118, 0.22), rgba(0, 242, 254, 0.22));
            color: #00e676;
            border: 1px solid rgba(0, 230, 118, 0.55);
            font-size: 9.5px;
            font-weight: 800;
            padding: 2px 7px;
            border-radius: 5px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            animation: glowGreen 2s infinite alternate;
        }
        @keyframes glowGreen {
            0% { box-shadow: 0 0 4px rgba(0, 230, 118, 0.3); }
            100% { box-shadow: 0 0 10px rgba(0, 230, 118, 0.8); }
        }

        .eq-anim-bars {
            display: inline-flex;
            align-items: flex-end;
            gap: 2px;
            height: 11px;
        }
        .eq-anim-bars span {
            width: 2.5px;
            background: #fff;
            border-radius: 1px;
            animation: eqBounce 0.8s ease-in-out infinite alternate;
        }
        .eq-anim-bars span:nth-child(1) { height: 4px; animation-delay: 0.1s; }
        .eq-anim-bars span:nth-child(2) { height: 10px; animation-delay: 0.3s; }
        .eq-anim-bars span:nth-child(3) { height: 6px; animation-delay: 0.2s; }
        @keyframes eqBounce {
            0% { height: 3px; }
            100% { height: 11px; }
        }

        .card-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .btn-add-queue {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 5px 9px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-add-queue:hover {
            background: var(--surface-hover);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .btn-add-playlist {
            background: linear-gradient(135deg, rgba(0, 230, 118, 0.15), rgba(0, 242, 254, 0.15));
            border: 1px solid rgba(0, 230, 118, 0.4);
            color: #00e676;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-add-playlist:hover {
            background: var(--success);
            color: #000;
            box-shadow: 0 0 10px rgba(0, 230, 118, 0.5);
        }

        /* BOTÃO FLUTUANTE DE SINCRONIZAR COM O YOUTUBE (FAB) */
        .floating-sync-btn {
            position: fixed;
            right: 22px;
            bottom: 98px; /* Fica acima da barra inferior fixa */
            background: linear-gradient(135deg, #ff0055, #ff5500);
            color: #fff;
            border: none;
            border-radius: 30px;
            padding: 10px 18px;
            font-size: 12.5px;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(255, 0, 85, 0.45), 0 0 16px rgba(255, 85, 0, 0.35);
            display: flex;
            align-items: center;
            gap: 8px;
            z-index: 40;
            transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .floating-sync-btn:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 10px 28px rgba(255, 0, 85, 0.65), 0 0 25px rgba(0, 242, 254, 0.4);
        }
        .floating-sync-btn.syncing .sync-icon {
            animation: spinSync 1s linear infinite;
        }
        @keyframes spinSync {
            100% { transform: rotate(360deg); }
        }

        /* MODAL EQUALIZADOR SPOTIFY */
        .eq-modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0, 0, 0, 0.78);
            backdrop-filter: blur(10px);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            animation: fadeIn 0.2s ease;
        }
        .eq-modal-card {
            background: #111422;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 22px;
            max-width: 620px;
            width: 100%;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.85);
            display: flex;
            flex-direction: column;
            gap: 12px;
            animation: scaleIn 0.22s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes scaleIn { from { transform: scale(0.95); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        
        .eq-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--border);
        }
        .eq-modal-title {
            font-size: 16px;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .eq-modal-sub {
            font-size: 11.5px;
            color: var(--text-dim);
            margin-top: 2px;
        }
        .eq-close-btn {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #fff;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .eq-close-btn:hover { background: var(--primary); }
        .eq-section-title {
            font-size: 11.5px;
            font-weight: 700;
            color: var(--accent);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .eq-presets-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .eq-preset-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 9px 11px;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .eq-preset-card:hover {
            background: var(--surface-hover);
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-1px);
        }
        .eq-preset-card.active {
            background: rgba(0, 242, 254, 0.12);
            border-color: var(--accent);
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.25);
        }
        .eq-preset-icon { font-size: 16px; }
        .eq-preset-name {
            font-size: 12px;
            font-weight: 700;
            color: #fff;
        }
        .eq-preset-desc {
            font-size: 10px;
            color: var(--text-dim);
            line-height: 1.25;
        }
        .eq-bars-row {
            display: flex;
            justify-content: space-around;
            align-items: center;
            background: rgba(0, 0, 0, 0.35);
            padding: 12px 10px;
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        .eq-bar-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }
        .eq-val-label {
            font-size: 10.5px;
            font-weight: 700;
            color: var(--accent);
            min-height: 14px;
        }
        .eq-slider-vertical {
            -webkit-appearance: slider-vertical;
            writing-mode: bt-lr;
            width: 6px;
            height: 75px;
            cursor: pointer;
        }
        .eq-freq-label {
            font-size: 10px;
            color: var(--text-dim);
            text-align: center;
            line-height: 1.2;
        }
        .eq-freq-label span {
            font-size: 9px;
            color: #888;
        }
        .eq-boost-box {
            background: rgba(255, 170, 0, 0.08);
            border: 1px solid rgba(255, 170, 0, 0.3);
            border-radius: 10px;
            padding: 10px 12px;
        }
        .eq-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 4px;
        }
        .eq-badge-saved {
            font-size: 11px;
            color: var(--success);
            font-weight: 600;
        }

        /* BARRA PRINCIPAL INFERIOR: ONDE ESTÁ A SELEÇÃO DA MÚSICA E TODOS OS COMANDOS */
        .bottom-player-bar {
            height: 88px;
            flex-shrink: 0;
            background: rgba(10, 12, 18, 0.98);
            backdrop-filter: blur(14px);
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 6px 20px;
            z-index: 30;
        }
        .bar-left { display: flex; align-items: center; gap: 12px; width: 270px; flex-shrink: 0; }
        .bar-thumb { width: 48px; height: 48px; border-radius: 8px; object-fit: cover; background: #1a1e2e; border: 1px solid var(--border); }
        .bar-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
        .bar-title { font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; }
        .bar-artist { font-size: 11.5px; color: var(--text-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        
        .bar-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            flex: 1;
            max-width: 680px;
        }

        /* SELEÇÃO DA PARTE DA MÚSICA (TIMELINE & SCRUBBER) */
        .progress-bar-container {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
        }
        .time-label {
            font-size: 10.5px;
            color: var(--text-dim);
            font-weight: 600;
            min-width: 34px;
            text-align: center;
            font-variant-numeric: tabular-nums;
        }
        .progress-track {
            position: relative;
            flex: 1;
            height: 5px;
            background: rgba(255, 255, 255, 0.16);
            border-radius: 3px;
            cursor: pointer;
            transition: height 0.15s;
        }
        .progress-track:hover {
            height: 7px;
        }
        .progress-fill {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--primary));
            border-radius: 3px;
            width: 0%;
            pointer-events: none;
        }
        .progress-scrubber {
            position: absolute;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 6px rgba(0, 242, 254, 0.8);
            left: 0%;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s;
        }
        .progress-track:hover .progress-scrubber {
            opacity: 1;
        }

        .bar-controls-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .bar-btn {
            background: transparent;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 15px;
            transition: transform 0.1s, color 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .bar-btn:hover { transform: scale(1.15); color: var(--accent); }
        .bar-play {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            box-shadow: 0 4px 12px rgba(255, 0, 85, 0.4);
        }
        .bar-pill-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .bar-pill-btn:hover {
            background: var(--surface-hover);
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .bar-pill-btn.active {
            background: rgba(0, 242, 254, 0.14);
            border-color: var(--accent);
            color: var(--accent);
        }
        .bar-pill-btn.fade-active {
            background: rgba(255, 0, 85, 0.15);
            border-color: var(--primary);
            color: var(--primary);
        }
        .bar-pill-btn.eq-active {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.15), rgba(255, 0, 85, 0.15));
            border-color: var(--accent);
            color: #fff;
        }

        .bar-status-text {
            font-size: 10.5px;
            color: var(--text-dim);
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: center;
            max-width: 600px;
        }
        .bar-status-text strong.playing {
            color: var(--accent);
        }
        .bar-status-text strong.next {
            color: #ffaa00;
        }

        .bar-right {
            display: flex;
            align-items: center;
            gap: 7px;
            width: 260px;
            justify-content: flex-end;
            flex-shrink: 0;
        }
        .volume-slider {
            flex: 1;
            -webkit-appearance: none;
            height: 5px;
            border-radius: 3px;
            background: rgba(255, 255, 255, 0.2);
            outline: none;
            cursor: pointer;
            max-width: 110px;
        }
        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--accent);
            cursor: pointer;
            box-shadow: 0 0 6px var(--accent);
        }
        .vol-text {
            font-size: 11.5px;
            font-weight: 700;
            color: var(--text-dim);
            min-width: 44px;
            text-align: right;
        }
        .vlc-chip-btn {
            background: rgba(255, 170, 0, 0.15);
            border: 1px solid rgba(255, 170, 0, 0.4);
            color: #ffaa00;
            padding: 3px 7px;
            border-radius: 5px;
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .vlc-chip-btn:hover {
            background: #ffaa00;
            color: #000;
        }

        /* SPOTIFY DJ AUTOMIXER */
        .spotify-dj-mixer {
            background: linear-gradient(145deg, #0e111a, #151926);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            padding: 7px 9px;
            margin-top: 4px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
            width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }
        .dj-mixer-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
        .dj-title {
            font-size: 10.5px;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: 0.8px;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .dj-pulse-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #00f2fe;
            box-shadow: 0 0 8px #00f2fe;
            animation: pulseDot 1.5s infinite;
        }
        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.4; transform: scale(0.7); }
        }
        .dj-bpm-sync {
            font-size: 9.5px;
            font-weight: 700;
            color: #ffaa00;
            background: rgba(255, 170, 0, 0.12);
            padding: 1px 5px;
            border-radius: 4px;
            border: 1px solid rgba(255, 170, 0, 0.3);
            white-space: nowrap;
        }
        .dj-decks-container {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 6px;
            width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }
        .dj-deck-card {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 7px;
            padding: 4px 7px;
            display: flex;
            flex-direction: column;
            gap: 3px;
            transition: all 0.3s ease;
            min-width: 0;
            width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }
        .dj-deck-card.active-deck {
            border-color: rgba(0, 242, 254, 0.45);
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.08), rgba(0, 0, 0, 0.4));
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.15);
        }
        .dj-deck-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 4px;
            width: 100%;
            min-width: 0;
            overflow: hidden;
        }
        .deck-tag {
            font-size: 9px;
            font-weight: 800;
            padding: 1px 4px;
            border-radius: 3px;
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-dim);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .deck-tag.active {
            background: linear-gradient(135deg, #ff0055, #ff5500);
            color: #fff;
            box-shadow: 0 0 6px rgba(255, 0, 85, 0.5);
        }
        .deck-bpm {
            font-size: 9px;
            font-weight: 700;
            color: var(--accent);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .dj-deck-body {
            display: flex;
            align-items: center;
            gap: 6px;
            min-width: 0;
            overflow: hidden;
            width: 100%;
        }
        .vinyl-disc {
            width: 20px;
            height: 20px;
            min-width: 20px;
            border-radius: 50%;
            background: repeating-radial-gradient(circle, #222 0, #111 2px, #333 3px, #111 4px);
            border: 1px solid #444;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            flex-shrink: 0;
        }
        .vinyl-disc.spinning {
            animation: spinVinyl 2s linear infinite;
        }
        @keyframes spinVinyl {
            100% { transform: rotate(360deg); }
        }
        .vinyl-center {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--primary);
            border: 1px solid #fff;
        }
        .dj-deck-info {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
            flex: 1;
            width: calc(100% - 26px);
        }
        .dj-deck-title {
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
            width: 100%;
            min-width: 0;
        }
        .dj-deck-artist {
            font-size: 8.5px;
            color: var(--text-dim);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
            width: 100%;
            min-width: 0;
        }
        .dj-deck-meter {
            height: 3px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
        }
        .dj-deck-meter .meter-bar {
            height: 100%;
            background: linear-gradient(90deg, #00e676, #ffaa00, #ff0055);
            transition: width 0.1s linear;
        }
        .dj-crossfader-wrapper {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .dj-crossfader-labels {
            display: flex;
            justify-content: space-between;
            font-size: 9px;
            font-weight: 700;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .dj-fader-track {
            height: 14px;
            background: #090b10;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 7px;
            position: relative;
            cursor: pointer;
            overflow: hidden;
        }
        .dj-fader-fill {
            height: 100%;
            background: linear-gradient(90deg, rgba(255, 0, 85, 0.4), rgba(0, 242, 254, 0.4));
            position: absolute;
            left: 0;
            top: 0;
            transition: width 0.08s linear;
        }
        .dj-fader-knob {
            width: 22px;
            height: 100%;
            background: #fff;
            border-radius: 4px;
            position: absolute;
            top: 0;
            transform: translateX(-50%);
            box-shadow: 0 0 8px rgba(0, 0, 0, 0.8), 0 0 5px rgba(255, 255, 255, 0.5);
            cursor: ew-resize;
            transition: left 0.08s linear;
        }
        .dj-mixer-actions {
            display: flex;
            gap: 6px;
        }
        .btn-dj-mix {
            flex: 1;
            background: linear-gradient(135deg, #181c2b, #21283d);
            border: 1px solid rgba(0, 242, 254, 0.3);
            color: var(--accent);
            font-size: 11px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }
        .btn-dj-mix:hover {
            background: var(--accent);
            color: #000;
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.5);
        }
        .badge-bpm-chip {
            background: rgba(255, 170, 0, 0.15);
            border: 1px solid rgba(255, 170, 0, 0.35);
            color: #ffaa00;
            font-size: 10px;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 6px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }


        /* ==========================================================
           EFEITO DINÂMICO AO CLICAR EM QUALQUER BOTÃO OU OPÇÃO DO PLAYER
           ========================================================== */
        button:active, 
        .btn-action:active, 
        .bar-btn:active, 
        .bar-pill-btn:active, 
        .btn-dj-mix:active, 
        .btn-radio-now:active, 
        .vlc-chip-btn:active, 
        .btn-add-playlist:active, 
        .btn-add-queue:active, 
        .nav-btn:active, 
        .category-tab:active,
        .dj-deck-card:active,
        .floating-sync-btn:active,
        .chip-bpm:active,
        .filter-tab-btn:active,
        .btn-search-ia-action:active,
        .btn-search-ext-quick:active {
            transform: scale(0.92) !important;
            filter: brightness(1.35) !important;
            box-shadow: 0 0 16px rgba(0, 242, 254, 0.8), inset 0 0 8px rgba(0, 242, 254, 0.4) !important;
            transition: transform 0.06s ease, filter 0.06s ease, box-shadow 0.06s ease !important;
        }

        .click-ripple-effect {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            animation: buttonRipple 0.45s linear;
            background: radial-gradient(circle, rgba(0, 242, 254, 0.6) 0%, rgba(255, 0, 85, 0.3) 60%, transparent 80%);
            pointer-events: none;
            z-index: 9999;
        }
        @keyframes buttonRipple {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* ESTILOS DA PESQUISA LIVRE & CHIPS DE BPM */
        .btn-search-ia-action {
            background: linear-gradient(135deg, #00f2fe, #4facfe);
            color: #000;
            border: none;
            padding: 6px 14px;
            font-size: 11px;
            font-weight: 800;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 4px;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .btn-search-ia-action:hover {
            filter: brightness(1.15);
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.5);
        }

        .btn-search-ext-quick {
            background: rgba(0, 242, 254, 0.12);
            border: 1px solid rgba(0, 242, 254, 0.3);
            color: var(--accent);
            padding: 4px 10px;
            font-size: 10px;
            font-weight: 700;
            border-radius: 6px;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }
        .btn-search-ext-quick:hover {
            background: var(--accent);
            color: #000;
        }

        .quick-bpm-chips-row {
            display: flex;
            gap: 6px;
            overflow-x: auto;
            padding: 5px 0;
            margin-top: 4px;
            scrollbar-width: none;
        }
        .quick-bpm-chips-row::-webkit-scrollbar {
            display: none;
        }
        .chip-bpm {
            background: var(--surface);
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 3px 8px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
            transition: all 0.2s;
        }
        .chip-bpm:hover {
            background: rgba(255, 170, 0, 0.15);
            border-color: rgba(255, 170, 0, 0.4);
            color: #ffaa00;
        }

        .search-filters-bar {
            display: flex;
            gap: 8px;
            margin-top: 6px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 6px;
        }
        .filter-tab-btn {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10.5px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .filter-tab-btn:hover {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.2);
        }
        .filter-tab-btn.active {
            background: rgba(0, 242, 254, 0.15);
            border-color: var(--accent);
            color: var(--accent);
        }

        .search-empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
            text-align: center;
            color: var(--text-dim);
        }
        .search-empty-icon {
            font-size: 36px;
            margin-bottom: 10px;
            filter: drop-shadow(0 0 12px var(--accent));
        }
        .search-empty-title {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 6px;
        }
        .search-empty-desc {
            font-size: 11.5px;
            max-width: 420px;
            line-height: 1.5;
        }


        /* BOTÕES DE FAIXAS PARECIDAS EM CARDS E NO PLAYER */
        .btn-similar-card {
            background: rgba(0, 242, 254, 0.12);
            border: 1px solid rgba(0, 242, 254, 0.35);
            color: var(--accent);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 8px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 3px;
            white-space: nowrap;
        }
        .btn-similar-card:hover {
            background: var(--accent);
            color: #000;
            box-shadow: 0 0 10px rgba(0, 242, 254, 0.5);
        }
        .btn-player-similar-action {
            background: linear-gradient(135deg, rgba(0, 242, 254, 0.18), rgba(255, 0, 85, 0.18));
            border: 1px solid var(--accent);
            color: #fff;
            font-size: 9.5px;
            font-weight: 700;
            padding: 3px 7px;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            white-space: nowrap;
        }
        .btn-player-similar-action:hover {
            background: var(--accent);
            color: #000;
            box-shadow: 0 0 12px rgba(0, 242, 254, 0.6);
        }
        .btn-bar-similar {
            background: rgba(0, 242, 254, 0.12);
            border: 1px solid rgba(0, 242, 254, 0.35);
            color: var(--accent);
            font-size: 9.5px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 5px;
            cursor: pointer;
            white-space: nowrap;
            margin-left: 6px;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }
        .btn-bar-similar:hover {
            background: var(--accent);
            color: #000;
        }

    </style>
</head>
<body>
    <!-- Cabeçalho Superior Fixo -->
    <div class="top-header-area">
        <div class="header-main-row">
            <div class="header-brand">
                <h1>Central de Músicas</h1>
                <p>Web Audio HD • Equalizador Spotify • Super Volume VLC (200%)</p>
            </div>
            <!-- Navegação Principal com 4 Abas -->
            <div class="top-nav">
                <button class="nav-btn active" id="navLibrary" onclick="switchView('library')">
                    <span id="navLibraryText">📚 Minha Biblioteca (__LIBRARY_COUNT__)</span>
                </button>
                <button class="nav-btn" id="navSearch" onclick="switchView('search')">
                    <span>🔍 Pesquisa Livre</span>
                </button>
                <button class="nav-btn" id="navSuggestions" onclick="switchView('suggestions')">
                    <span>✨ Músicas Sugeridas (IA)</span>
                </button>
                <button class="nav-btn" id="navQueue" onclick="switchView('queue')">
                    <span>📋 Minha Fila</span>
                    <span class="queue-badge" id="queueBadgeCount">0</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Layout Dividido em Duas Colunas: Player Fixo e Lista de Músicas -->
    <div class="main-container">
        <!-- Player Fixo à Esquerda (SEM COMANDOS DUPLICADOS, ZERO ROLAGEM, TOTALMENTE FIXO) -->
        <div class="player-pane">
            <div class="player-wrapper">
                
                <!-- Decks de Vídeo & Tela Visualizador de Áudio HD -->
                <div class="video-container" id="videoContainer">
                    <!-- YouTube Iframe Decks -->
                    <div id="deckA" class="deck-player"></div>
                    <div id="deckB" class="deck-player"></div>

                    <!-- Visualizador HD de Áudio (Ativo no Modo Áudio ou quando vídeo bloqueado) -->
                    <div id="visualizerScreen" class="visualizer-screen">
                        <div class="vis-bg-blur" id="visBgBlur"></div>
                        <div class="vis-mode-tag" id="visModeTag" onclick="cycleVlcBoost()" title="Clique para alternar o volume VLC" style="cursor: pointer;">
                            <span class="dot"></span>
                            <span id="visTagText">ÁUDIO HD • 100%</span>
                        </div>
                        <div class="vis-content">
                            <div class="vis-art-wrapper">
                                <img id="visAlbumArt" src="" class="vis-art-img pulse" alt="Capa da Faixa">
                            </div>
                            <canvas id="visCanvas" class="vis-canvas" width="360" height="38"></canvas>
                        </div>
                    </div>
                </div>

                <div id="crossfadeIndicator" class="crossfade-indicator">
                    🎚️ Fazendo Crossfade suave para a próxima música...
                </div>

                <div id="toastNotify" class="toast-notify"></div>

                <!-- Detalhes da Faixa Atual -->
                <div class="current-track-info">
                    <div class="current-track-title" id="trackTitle">Pronto para tocar</div>
                    <div class="current-track-artist" id="trackArtist">Selecione uma faixa para começar</div>
                    <div class="track-status-row">
                        <div style="display: flex; gap: 4px; align-items: center;">
                            <span class="badge-source" id="trackSource">Fila Ativa</span>
                            <span class="now-playing-pill" id="trackNowPlayingPill">Tocando</span>
                        </div>
                        <button class="btn-player-similar-action" id="btnPlayerSimilar" onclick="openRadioForCurrentTrack()" title="Buscar faixas parecidas com esta música (mesmo BPM e ritmo)">
                            📻 Faixas Parecidas
                        </button>
                    </div>
                </div>

                <!-- SPOTIFY DJ MIXER PANEL -->
                <div class="spotify-dj-mixer" id="spotifyDjMixer">
                    <div class="dj-mixer-header">
                        <div class="dj-title">
                            <span class="dj-pulse-dot"></span>
                            <span>🎧 SPOTIFY DJ MIXER</span>
                        </div>
                        <span class="dj-bpm-sync" id="djBpmSyncBadge">⚡ Sincronia: ~138 BPM</span>
                    </div>

                    <!-- Dual Decks A & B -->
                    <div class="dj-decks-container">
                        <!-- Deck A -->
                        <div class="dj-deck-card active-deck" id="djDeckACard">
                            <div class="dj-deck-top">
                                <span class="deck-tag active" id="deckATag">DECK A</span>
                                <span class="deck-bpm" id="deckABpm">138 BPM</span>
                            </div>
                            <div class="dj-deck-body">
                                <div class="vinyl-disc spinning" id="vinylA">
                                    <div class="vinyl-center"></div>
                                </div>
                                <div class="dj-deck-info">
                                    <div class="dj-deck-title" id="deckATitle">Tocando agora</div>
                                    <div class="dj-deck-artist" id="deckAArtist">-</div>
                                </div>
                            </div>
                            <div class="dj-deck-meter">
                                <div class="meter-bar" id="meterA" style="width: 100%;"></div>
                            </div>
                        </div>

                        <!-- Deck B -->
                        <div class="dj-deck-card" id="djDeckBCard">
                            <div class="dj-deck-top">
                                <span class="deck-tag" id="deckBTag">DECK B</span>
                                <span class="deck-bpm" id="deckBBpm">138 BPM</span>
                            </div>
                            <div class="dj-deck-body">
                                <div class="vinyl-disc" id="vinylB">
                                    <div class="vinyl-center"></div>
                                </div>
                                <div class="dj-deck-info">
                                    <div class="dj-deck-title" id="deckBTitle">Próxima faixa</div>
                                    <div class="dj-deck-artist" id="deckBArtist">-</div>
                                </div>
                            </div>
                            <div class="dj-deck-meter">
                                <div class="meter-bar" id="meterB" style="width: 0%;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Crossfader Slider -->
                    <div class="dj-crossfader-wrapper">
                        <div class="dj-crossfader-labels">
                            <span>DECK A</span>
                            <span id="crossfaderBalanceText">Crossfade Automático: 4s</span>
                            <span>DECK B</span>
                        </div>
                        <div class="dj-fader-track" id="djFaderTrack">
                            <div class="dj-fader-fill" id="djFaderFill" style="width: 0%;"></div>
                            <div class="dj-fader-knob" id="djFaderKnob" style="left: 0%;"></div>
                        </div>
                    </div>

                    <!-- Ações Rápidas do Mixer -->
                    <div class="dj-mixer-actions">
                        <button class="btn-dj-mix" onclick="manualTransition('next')" title="Fazer transição com fade agora">
                            🎚️ Transição com Fade
                        </button>
                        <button class="btn-radio-now" id="btnRadioNow" onclick="openRadioForCurrentTrack()" title="Buscar músicas parecidas no mesmo gênero e ritmo desta faixa com IA">
                            <span>📻 Spotify AI Rádio (BPM)</span>
                        </button>
                    </div>
                </div>
                
                <div class="actions-grid">
                    <a id="btnQueue" href="#" target="_blank" class="btn-action btn-queue">
                        ▶ Fila no YouTube
                    </a>
                    <a id="btnYt" href="#" target="_blank" class="btn-action btn-yt">
                        Ver no YouTube
                    </a>
                    <a id="btnYtMusic" href="#" target="_blank" class="btn-action btn-ytmusic">
                        YT Music
                    </a>
                </div>
            </div>
        </div>

        <!-- Painel de Listas à Direita: O ÚNICO QUE TEM SCROLLBAR -->
        <div class="list-pane">
            <!-- Painel de Biblioteca -->
            <div id="paneLibrary" class="pane-view">
                <div class="pane-fixed-header">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="searchInput" class="search-input-field" placeholder="Buscar música, artista, ritmo ou BPM em toda biblioteca..." oninput="handleLibrarySearch(this.value)" onkeydown="if(event.key==='Enter') goToFreeSearch(this.value)">
                        <button id="btnClearSearch" class="btn-clear-search" onclick="clearLibrarySearch()" title="Limpar busca" style="display: none;">✕</button>
                        <button class="btn-search-ext-quick" onclick="goToFreeSearch(document.getElementById('searchInput').value)" title="Abrir Pesquisa Livre no YouTube com IA">
                            ⚡ Pesquisa Livre
                        </button>
                        <span id="searchBadgeCount" class="search-badge"></span>
                    </div>

                    <!-- Abas de Categorias da Biblioteca com Auto-Scroll no Hover -->
                    <div class="tabs-nav-outer" id="tabsNavOuter">
                        <button class="tabs-scroll-btn left" id="tabsScrollLeft" title="Rolar para a esquerda">‹</button>
                        <div class="tabs-wrapper" id="tabsWrapper">
                            <div class="tabs" id="tabsContainer"></div>
                        </div>
                        <button class="tabs-scroll-btn right" id="tabsScrollRight" title="Rolar para a direita">›</button>
                    </div>
                </div>
                <div class="track-list" id="trackList"></div>
            </div>

            <!-- NOVO: Painel de Pesquisa Livre (Biblioteca Completa + YouTube + Descobertas IA) -->
            <div id="paneSearch" class="pane-view" style="display: none;">
                <div class="pane-fixed-header">
                    <div class="search-input-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" id="freeSearchInput" class="search-input-field" placeholder="Pesquise qualquer música, artista, ritmo ou BPM no YouTube e Biblioteca..." oninput="handleFreeSearchInput(this.value)" onkeydown="if(event.key==='Enter') executeFreeSearch(this.value)">
                        <button id="btnFreeSearchClear" class="btn-clear-search" onclick="clearFreeSearch()" title="Limpar busca" style="display: none;">✕</button>
                        <button class="btn-search-ia-action" onclick="executeFreeSearch(document.getElementById('freeSearchInput').value)">
                            ⚡ Buscar IA
                        </button>
                    </div>
                    
                    <!-- Chips de BPM & Ritmo Rápido -->
                    <div class="quick-bpm-chips-row">
                        <button class="chip-bpm" onclick="quickBpmSearch('Mega Funk 135 BPM')">⚡ 135 BPM Mega Funk</button>
                        <button class="chip-bpm" onclick="quickBpmSearch('Mandelao 130 BPM')">🔊 130 BPM Mandelão</button>
                        <button class="chip-bpm" onclick="quickBpmSearch('Eletronica House 126 BPM')">🎛️ 126 BPM House</button>
                        <button class="chip-bpm" onclick="quickBpmSearch('Funk 150 BPM')">🔥 150 BPM Ritmo dos Fluxos</button>
                        <button class="chip-bpm" onclick="quickBpmSearch('Trap Brasil')">💎 Trap Brasil</button>
                    </div>

                    <div class="search-filters-bar" id="searchFiltersBar" style="display: flex;">
                        <button class="filter-tab-btn active" id="tabFilterAll" onclick="setSearchFilter('all')">Todas (<span id="countSearchAll">0</span>)</button>
                        <button class="filter-tab-btn" id="tabFilterLib" onclick="setSearchFilter('library')">📚 Na Biblioteca (<span id="countSearchLib">0</span>)</button>
                        <button class="filter-tab-btn" id="tabFilterNew" onclick="setSearchFilter('new')">✨ Novidades YouTube (<span id="countSearchNew">0</span>)</button>
                    </div>
                </div>
                <div class="track-list" id="searchResultsList">
                    <div class="search-empty-state">
                        <div class="search-empty-icon">🔍</div>
                        <div class="search-empty-title">Pesquisa Livre no YouTube & Biblioteca</div>
                        <div class="search-empty-desc">Digite qualquer título, artista, ritmo ou BPM para encontrar instantaneamente na biblioteca ou descobrir novas faixas no YouTube com transição Crossfade e adição com um clique!</div>
                    </div>
                </div>
            </div>

            <!-- Painel de Sugestões com Categorias & Busca Sem Repetição -->
            <div id="paneSuggestions" class="pane-view" style="display: none;">
                <div class="pane-fixed-header">
                    <div style="margin-bottom: 5px;">
                        <span style="font-size: 12px; font-weight: 700; color: var(--accent);">🎯 Escolha o Gênero ou ative o Rádio da Faixa:</span>
                    </div>
                    <div class="tabs-nav-outer" id="suggTabsNavOuter">
                        <button class="tabs-scroll-btn left" id="suggScrollLeft" title="Rolar para a esquerda">‹</button>
                        <div class="tabs-wrapper" id="suggestionsTabsWrapper">
                            <div class="tabs" id="suggestionsTabsContainer"></div>
                        </div>
                        <button class="tabs-scroll-btn right" id="suggScrollRight" title="Rolar para a direita">›</button>
                    </div>

                    <!-- Campo de Busca de Novidades com IA -->
                    <div class="search-input-wrapper" style="margin-top: 6px; margin-bottom: 6px;">
                        <span class="search-icon">✨</span>
                        <input type="text" id="suggSearchInput" class="search-input-field" placeholder="Buscar novas músicas no YouTube por ritmo, artista ou BPM (ex: 135 bpm, mandelao)..." onkeydown="if(event.key==='Enter') executeCustomSuggestionSearch(this.value)">
                        <button class="btn-sync-yt" onclick="executeCustomSuggestionSearch(document.getElementById('suggSearchInput').value)" style="margin-top:0; padding: 6px 14px; font-size: 11px; font-weight: 700; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #000; border-radius: 6px;">
                            Buscar IA
                        </button>
                    </div>

                    <div class="queue-header-box" style="margin-top: 8px; margin-bottom: 8px;">
                        <div class="queue-title">
                            <span id="suggestionActiveGenreTitle">✨ Novidades Recomendadas</span>
                            <span id="suggestionCountBadge" class="count-badge" style="background: rgba(0, 242, 254, 0.2); color: var(--accent); padding: 3px 8px; font-size: 11px;">Carregando...</span>
                        </div>
                        <div class="queue-desc" id="suggestionSubtext">
                            Músicas buscadas em tempo real no YouTube para este estilo e ritmo. <strong>Nunca se repetem</strong>.
                        </div>
                        <div style="display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;">
                            <button class="btn-sync-yt" id="btnRefreshSuggestions" onclick="fetchFreshSuggestionsForCurrentGenre()" style="flex: 1; margin-top: 0; background: linear-gradient(135deg, #ff0055, #ff5500); color: #fff; padding: 7px 12px; font-size: 12px;">
                                <span>🔄 Buscar Mais Novas Músicas (Sem Repetir)</span>
                            </button>
                            <button class="btn-sync-yt" onclick="resetSeenHistory()" style="flex: 0; margin-top: 0; background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); padding: 7px 12px; font-size: 12px;" title="Resetar histórico de faixas já vistas">
                                <span>↺ Resetar Histórico</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="track-list" id="suggestionsList"></div>
            </div>

            <!-- Painel de Fila de Reprodução -->
            <div id="paneQueue" class="pane-view" style="display: none;">
                <div class="pane-fixed-header">
                    <div class="queue-header-box">
                        <div class="queue-title">
                            <span>📋 Minha Fila de Reprodução</span>
                            <span id="queueCountBadge" class="count-badge" style="background: rgba(0, 242, 254, 0.2); color: var(--accent); padding: 3px 8px;">0 músicas</span>
                        </div>
                        <div class="queue-desc">
                            Músicas adicionadas por você para tocar na sequência. Você pode abri-las todas juntas como uma playlist instantânea no YouTube!
                        </div>
                        <div style="display: flex; gap: 10px; margin-top: 10px;">
                            <button class="btn-sync-yt" onclick="openDirectQueueUrl()" style="flex: 1; margin-top: 0;">
                                ▶ Assistir Fila Completa no YouTube
                            </button>
                            <button class="btn-sync-yt" onclick="clearAllQueue()" style="flex: 0; margin-top: 0; background: rgba(255, 0, 85, 0.2); border: 1px solid var(--primary); color: #fff; padding: 8px 14px;">
                                🗑️ Limpar
                            </button>
                        </div>
                    </div>
                </div>
                <div class="track-list" id="queueList"></div>
            </div>
        </div>
    </div>

    <!-- BOTÃO FLUTUANTE DE SINCRONIZAR COM O YOUTUBE (FAB) -->
    <button class="floating-sync-btn" id="floatingSyncBtn" onclick="triggerYouTubeSync()" title="Sincronizar sua playlist do YouTube com um clique">
        <span class="sync-icon">🔄</span>
        <span id="syncBtnText">Sincronizar com YouTube</span>
    </button>

    <!-- Barra Principal Inferior (ONDE ESTÁ A SELEÇÃO DA MÚSICA E TODOS OS COMANDOS) -->
    <div class="bottom-player-bar">
        <div class="bar-left">
            <img id="barThumb" src="" class="bar-thumb" alt="Capa">
            <div class="bar-info">
                <div class="bar-title" id="barTitle">Nenhuma música tocando</div>
                <div class="bar-artist" id="barArtist">-</div>
            </div>
            <button class="btn-bar-similar" onclick="openRadioForCurrentTrack()" title="Buscar faixas parecidas com esta música">
                📻 Parecidas
            </button>
        </div>

        <div class="bar-center">
            <!-- SELEÇÃO DA PARTE DA MÚSICA (TIMELINE & SCRUBBER) -->
            <div class="progress-bar-container">
                <span class="time-label" id="timeCurrent">0:00</span>
                <div class="progress-track" id="progressTrack" onclick="handleSeekClick(event)" title="Clique para avançar/voltar nesta parte da música">
                    <div class="progress-fill" id="progressFill"></div>
                    <div class="progress-scrubber" id="progressScrubber"></div>
                </div>
                <span class="time-label" id="timeDuration">0:00</span>
            </div>

            <!-- Linha de Controles do Player Principal -->
            <div class="bar-controls-row">
                <button class="bar-pill-btn" id="barShuffleBtn" onclick="toggleShuffle()" title="Modo Aleatório">🔀 Shuffle</button>
                <button class="bar-btn" onclick="manualTransition('prev')" title="Anterior">⏮</button>
                <button class="bar-btn bar-play" id="barPlayBtn" onclick="togglePlayPause()" title="Play/Pause">⏸</button>
                <button class="bar-btn" onclick="manualTransition('next')" title="Próxima com Fade">⏭</button>
                <button class="bar-pill-btn active" id="barAutoPlayBtn" onclick="toggleAutoPlay()" title="Avanço Automático">🔁 Auto</button>
                
                <button class="bar-pill-btn fade-active" id="barCrossfadeBtn" onclick="toggleCrossfadeSetting()" title="Ajustar tempo de crossfade">🎚️ Fade: 4s</button>
                <button class="bar-pill-btn active" id="barIntroSkipBtn" onclick="toggleIntroSkip()" title="Pular silêncio/intro inicial">⚡ Silêncio: 2s</button>
                <button class="bar-pill-btn eq-active" id="barEqBtn" onclick="openEqualizerModal()" title="Equalizador Spotify e Super Volume VLC">🎛️ EQ: <span id="barEqLabel">Grave</span></button>
                <button class="bar-pill-btn" id="barControlSimilarBtn" onclick="openRadioForCurrentTrack()" title="Buscar faixas parecidas com a música tocando no mesmo ritmo e BPM com IA">📻 Faixas Parecidas</button>
                
                <!-- Toggle de Áudio HD vs Clipe -->
                <button class="bar-pill-btn" id="barEngineModeBtn" onclick="toggleEngineMode()" title="Alternar entre Áudio HD (Equalizador + 200% VLC) e Clipe YouTube">🎵 Áudio HD</button>
            </div>

            <!-- Linha de Status com a Música Tocando e a Próxima -->
            <div class="bar-status-text" id="barStatusText">
                Pronto para reproduzir • Escolha uma música
            </div>
        </div>

        <div class="bar-right">
            <button class="bar-btn" id="barMuteBtn" onclick="toggleMute()" title="Mute/Unmute">🔊</button>
            <input type="range" min="0" max="200" value="100" id="volumeSlider" class="volume-slider" oninput="setMasterVolume(this.value)" onchange="setMasterVolume(this.value)" title="Volume VLC (0% a 200%)">
            <span class="vol-text" id="volText">100%</span>
            <button class="vlc-chip-btn" onclick="cycleVlcBoost()" title="Alternar presets VLC (100%, 125%, 150%, 200%)">⚡ VLC</button>
        </div>
    </div>

    <!-- MODAL DO EQUALIZADOR SPOTIFY & SUPER VOLUME VLC -->
    <div class="eq-modal-overlay" id="equalizerModal" onclick="closeEqualizerModal(event)">
        <div class="eq-modal-card" onclick="event.stopPropagation()">
            <div class="eq-modal-header">
                <div>
                    <div class="eq-modal-title">
                        <span>🎛️ Equalizador Spotify & Super Volume VLC</span>
                    </div>
                    <div class="eq-modal-sub">
                        Filtro acústico em tempo real e amplificação até 200% sem distorção.
                    </div>
                </div>
                <button class="eq-close-btn" onclick="closeEqualizerModal()">&times;</button>
            </div>

            <!-- Presets Acústicos Inteligentes -->
            <div class="eq-section-title">Presets Acústicos Rápidos</div>
            <div class="eq-presets-grid">
                <div class="eq-preset-card" id="eqCard_padrao" onclick="selectEqPreset('padrao')">
                    <span class="eq-preset-icon">🎵</span>
                    <span class="eq-preset-name">Padrão (Flat)</span>
                    <span class="eq-preset-desc">Áudio neutro original sem alterações</span>
                </div>
                <div class="eq-preset-card" id="eqCard_grave" onclick="selectEqPreset('grave')">
                    <span class="eq-preset-icon">💥</span>
                    <span class="eq-preset-name">Mais Grave</span>
                    <span class="eq-preset-desc">Subwoofer & batidas pesadas reforçadas</span>
                </div>
                <div class="eq-preset-card" id="eqCard_voz" onclick="selectEqPreset('voz')">
                    <span class="eq-preset-icon">🎙️</span>
                    <span class="eq-preset-name">Mais Voz</span>
                    <span class="eq-preset-desc">Vocais nítidos e médios destacados</span>
                </div>
                <div class="eq-preset-card" id="eqCard_sala" onclick="selectEqPreset('sala')">
                    <span class="eq-preset-icon">🏛️</span>
                    <span class="eq-preset-name">Sala / Espacial</span>
                    <span class="eq-preset-desc">Sensação ampla de ambiente e reverb</span>
                </div>
                <div class="eq-preset-card" id="eqCard_fone" onclick="selectEqPreset('fone')">
                    <span class="eq-preset-icon">🎧</span>
                    <span class="eq-preset-name">Fone de Ouvido</span>
                    <span class="eq-preset-desc">Clareza nos agudos e presença de graves</span>
                </div>
                <div class="eq-preset-card" id="eqCard_balada" onclick="selectEqPreset('balada')">
                    <span class="eq-preset-icon">⚡</span>
                    <span class="eq-preset-name">Balada / Club</span>
                    <span class="eq-preset-desc">Pressão sonora total para festas</span>
                </div>
            </div>

            <!-- Equalizador Gráfico de 5 Bandas -->
            <div class="eq-section-title">Equalizador Gráfico (5 Bandas)</div>
            <div class="eq-bars-row">
                <div class="eq-bar-col">
                    <span class="eq-val-label" id="eqVal_60">0 dB</span>
                    <input type="range" min="-12" max="12" value="0" class="eq-slider-vertical" id="eqSlider_60" oninput="onCustomEqChange(0, this.value)">
                    <div class="eq-freq-label">60 Hz<br><span>Sub-Grave</span></div>
                </div>
                <div class="eq-bar-col">
                    <span class="eq-val-label" id="eqVal_230">0 dB</span>
                    <input type="range" min="-12" max="12" value="0" class="eq-slider-vertical" id="eqSlider_230" oninput="onCustomEqChange(1, this.value)">
                    <div class="eq-freq-label">230 Hz<br><span>Grave</span></div>
                </div>
                <div class="eq-bar-col">
                    <span class="eq-val-label" id="eqVal_910">0 dB</span>
                    <input type="range" min="-12" max="12" value="0" class="eq-slider-vertical" id="eqSlider_910" oninput="onCustomEqChange(2, this.value)">
                    <div class="eq-freq-label">910 Hz<br><span>Voz / Médio</span></div>
                </div>
                <div class="eq-bar-col">
                    <span class="eq-val-label" id="eqVal_3600">0 dB</span>
                    <input type="range" min="-12" max="12" value="0" class="eq-slider-vertical" id="eqSlider_3600" oninput="onCustomEqChange(3, this.value)">
                    <div class="eq-freq-label">3.6 kHz<br><span>Presença</span></div>
                </div>
                <div class="eq-bar-col">
                    <span class="eq-val-label" id="eqVal_14000">0 dB</span>
                    <input type="range" min="-12" max="12" value="0" class="eq-slider-vertical" id="eqSlider_14000" oninput="onCustomEqChange(4, this.value)">
                    <div class="eq-freq-label">14 kHz<br><span>Agudos</span></div>
                </div>
            </div>

            <!-- Super Volume VLC Booster (Até 200%) -->
            <div class="eq-boost-box">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <span style="font-size: 11.5px; font-weight: 700; color: #ffaa00;">⚡ Super Volume VLC Booster (0% a 200%)</span>
                    <span id="eqBoostText" style="font-size: 12px; font-weight: 800; color: #ffaa00;">100%</span>
                </div>
                <input type="range" min="0" max="200" value="100" id="eqVolumeSlider" class="volume-slider" style="width: 100%; max-width: none;" oninput="setMasterVolume(this.value)">
                <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--text-dim); margin-top: 4px;">
                    <span>0%</span>
                    <span>100% (Normal)</span>
                    <span>150% (Turbo VLC)</span>
                    <span style="color: #ff0055; font-weight: 700;">200% (Máx VLC)</span>
                </div>
            </div>

            <div class="eq-footer">
                <span class="eq-badge-saved">✓ Preferências salvas automaticamente</span>
                <button class="btn-sync-yt" onclick="closeEqualizerModal()" style="margin-top: 0; padding: 7px 18px; width: auto; font-size: 12px;">Concluído</button>
            </div>
        </div>
    </div>

    <!-- YouTube IFrame API -->
    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        const DATA = __DATA_JSON__;
        const ICONS = __ICONS_JSON__;
        const CATEGORIES = __CATEGORIES_JSON__;

        // CONFIGURAÇÕES DE EQUALIZADOR ESTILO SPOTIFY
        const EQ_PRESETS = {
            "padrao": { name: "Padrão", icon: "🎵", gains: [0, 0, 0, 0, 0] },
            "grave": { name: "Mais Grave", icon: "💥", gains: [10, 6, 0, -1, 1] },
            "voz": { name: "Mais Voz", icon: "🎙️", gains: [-3, 1, 7, 5, 1] },
            "sala": { name: "Sala / Espacial", icon: "🏛️", gains: [4, -2, 2, 4, 6] },
            "fone": { name: "Fone de Ouvido", icon: "🎧", gains: [5, 2, 1, 6, 7] },
            "balada": { name: "Balada / Club", icon: "⚡", gains: [10, 6, -2, 3, 8] }
        };

        // CARREGAR PREFERÊNCIAS SALVAS DO USUÁRIO (localStorage)
        let savedFade = localStorage.getItem("pref_crossfadeSeconds");
        let crossfadeSeconds = savedFade !== null ? parseInt(savedFade, 10) : 4;

        let savedSilence = localStorage.getItem("pref_introSkipSeconds");
        let introSkipSeconds = savedSilence !== null ? parseFloat(savedSilence) : 2.0;

        let savedVol = localStorage.getItem("pref_masterVolume");
        let masterVolume = savedVol !== null ? parseInt(savedVol, 10) : 100;
        let prevMasterVolume = masterVolume > 0 ? masterVolume : 100;

        let savedAuto = localStorage.getItem("pref_autoPlay");
        let isAutoPlayEnabled = savedAuto !== null ? (savedAuto === "true") : true;

        let savedShuff = localStorage.getItem("pref_shuffle");
        let isShuffleEnabled = savedShuff !== null ? (savedShuff === "true") : false;

        let currentEqPreset = localStorage.getItem("pref_eq_preset") || "grave";
        let engineMode = localStorage.getItem("pref_engine_mode") || "audio"; // "audio" ou "video"
        let lastAddedVideoId = localStorage.getItem("pref_last_added_id") || "";

        // NAVEGAÇÃO
        let browseView = "library";
        let browseCategory = CATEGORIES[0];
        let currentSuggestionCategory = CATEGORIES[0];
        let isRadioActive = false;

        // REPRODUÇÃO PERSISTENTE
        let nowPlayingQueue = DATA[CATEGORIES[0]] || [];
        let nowPlayingIndex = 0;
        let nowPlayingTrack = nowPlayingQueue.length > 0 ? nowPlayingQueue[0] : null;
        let nowPlayingCategoryName = CATEGORIES[0];

        // DUAL-DECK PLAYERS (YOUTUBE IFRAME)
        let playerA = null;
        let playerB = null;
        let activeDeck = "A"; // "A" ou "B"
        let isPlayerAReady = false;
        let isPlayerBReady = false;

        // WEB AUDIO HD ENGINE
        let audioCtx = null;
        let audioDeckA = null;
        let audioDeckB = null;
        let sourceNodeA = null;
        let sourceNodeB = null;
        let deckGainA = null;
        let deckGainB = null;
        let eqFilters = [];
        let compressorNode = null;
        let masterGainNode = null;
        let analyserNode = null;
        let animFrameId = null;

        let isMuted = false;
        let isTransitioning = false;
        let crossfadeTimer = null;
        let hasFadedCurrentTrack = false;
        let timeMonitorInterval = null;
        let searchDebounceTimer = null;
        let trackDurations = {};
        let prewarmedUpcomingId = "";

        // Cache de sugestões por gênero e por rádio de música
        let suggestionsByGenre = {};
        let radioSuggestionsCache = {};
        let pendingQueue = [];

        // Inicializar Web Audio HD Engine
        function initWebAudio() {
            if (audioCtx) return;
            try {
                const AudioCtxClass = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioCtxClass();

                audioDeckA = new Audio();
                audioDeckA.crossOrigin = "anonymous";
                audioDeckA.preload = "auto";

                audioDeckB = new Audio();
                audioDeckB.crossOrigin = "anonymous";
                audioDeckB.preload = "auto";

                sourceNodeA = audioCtx.createMediaElementSource(audioDeckA);
                sourceNodeB = audioCtx.createMediaElementSource(audioDeckB);

                deckGainA = audioCtx.createGain();
                deckGainB = audioCtx.createGain();
                deckGainA.gain.value = 1.0;
                deckGainB.gain.value = 0.0;

                sourceNodeA.connect(deckGainA);
                sourceNodeB.connect(deckGainB);

                const deckMixer = audioCtx.createGain();
                deckGainA.connect(deckMixer);
                deckGainB.connect(deckMixer);

                // 5 Filtros Biquad (60Hz, 230Hz, 910Hz, 3.6kHz, 14kHz)
                const freqs = [60, 230, 910, 3600, 14000];
                const types = ["lowshelf", "peaking", "peaking", "peaking", "highshelf"];
                eqFilters = freqs.map((f, i) => {
                    const filter = audioCtx.createBiquadFilter();
                    filter.type = types[i];
                    filter.frequency.value = f;
                    if (types[i] === "peaking") filter.Q.value = 1.0;
                    filter.gain.value = 0;
                    return filter;
                });

                deckMixer.connect(eqFilters[0]);
                for (let i = 0; i < eqFilters.length - 1; i++) {
                    eqFilters[i].connect(eqFilters[i + 1]);
                }

                // Master Gain (Super Volume VLC 0% a 200%)
                masterGainNode = audioCtx.createGain();
                const initVol = isMuted ? 0 : (masterVolume / 100);
                masterGainNode.gain.value = initVol;
                eqFilters[eqFilters.length - 1].connect(masterGainNode);

                // Compressor & Brickwall Peak Limiter (Protege caixas de som e fones contra distorção mesmo a 200% VLC)
                compressorNode = audioCtx.createDynamicsCompressor();
                compressorNode.threshold.value = -0.5; // Limita rigorosamente em -0.5 dBFS
                compressorNode.knee.value = 4.0;
                compressorNode.ratio.value = 20.0; // Brickwall Limiter
                compressorNode.attack.value = 0.001; // Resposta ultrarrápida (1ms) evita qualquer estouro de transiente
                compressorNode.release.value = 0.08;
                masterGainNode.connect(compressorNode);

                // Analisador para o Visualizador em tempo real
                analyserNode = audioCtx.createAnalyser();
                analyserNode.fftSize = 64;
                compressorNode.connect(analyserNode);
                analyserNode.connect(audioCtx.destination);

                // Configura ouvintes dos decks HTML5
                setupAudioEvents(audioDeckA, "A");
                setupAudioEvents(audioDeckB, "B");

                selectEqPreset(currentEqPreset);
                startVisualizerLoop();
            } catch (err) {
                console.warn("Web Audio API:", err);
            }
        }

        function setupAudioEvents(audioEl, deckName) {
            audioEl.addEventListener("play", () => {
                if (deckName === activeDeck && engineMode === "audio") {
                    updatePlayPauseButtons(true);
                    hideToast();
                }
            });
            audioEl.addEventListener("pause", () => {
                if (deckName === activeDeck && engineMode === "audio" && !isTransitioning) {
                    updatePlayPauseButtons(false);
                }
            });
            audioEl.addEventListener("ended", () => {
                if (deckName === activeDeck && engineMode === "audio") {
                    if (isAutoPlayEnabled && !hasFadedCurrentTrack && !isTransitioning) {
                        hasFadedCurrentTrack = true;
                        autoAdvanceWithFade();
                    }
                }
            });
            audioEl.addEventListener("error", (e) => {
                console.warn(`Deck ${deckName} erro de streaming.`, e);
            });
        }

        // Alternar modo de reprodução: Áudio HD vs Clipe YouTube
        function toggleEngineMode() {
            setEngineMode(engineMode === "audio" ? "video" : "audio");
        }

        function setEngineMode(mode) {
            engineMode = mode;
            localStorage.setItem("pref_engine_mode", mode);
            
            const btnBar = document.getElementById("barEngineModeBtn");
            const visScreen = document.getElementById("visualizerScreen");

            if (btnBar) {
                btnBar.innerHTML = mode === "audio" ? "🎵 Áudio HD" : "🎬 Clipe";
                btnBar.className = `bar-pill-btn ${mode === "audio" ? "active" : ""}`;
            }
            updateVolumeUI();

            if (mode === "audio") {
                if (visScreen) visScreen.style.display = "flex";
                if (playerA && typeof playerA.pauseVideo === "function") {
                    try { playerA.pauseVideo(); playerA.setVolume(0); } catch (e) {}
                }
                if (playerB && typeof playerB.pauseVideo === "function") {
                    try { playerB.pauseVideo(); playerB.setVolume(0); } catch (e) {}
                }
                showToast("🎵 Áudio HD ativo: Equalizador Spotify, 200% VLC e ZERO bloqueios!");
            } else {
                if (visScreen) visScreen.style.display = "none";
                if (audioDeckA) audioDeckA.pause();
                if (audioDeckB) audioDeckB.pause();
                showToast("🎬 Modo Clipe ativo: Exibindo vídeo oficial.");
            }

            if (nowPlayingTrack) {
                playTrackInstant(nowPlayingTrack);
            }
        }

        // Loop do Visualizador de Frequências (Canvas)
        function startVisualizerLoop() {
            if (animFrameId) cancelAnimationFrame(animFrameId);
            const canvas = document.getElementById("visCanvas");
            if (!canvas) return;
            const ctx = canvas.getContext("2d");
            const bufferLength = analyserNode ? analyserNode.frequencyBinCount : 32;
            const dataArray = new Uint8Array(bufferLength);

            function draw() {
                animFrameId = requestAnimationFrame(draw);
                if (!analyserNode || engineMode !== "audio") return;

                analyserNode.getByteFrequencyData(dataArray);
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                const barWidth = (canvas.width / bufferLength) * 2.2;
                let x = 0;

                for (let i = 0; i < bufferLength; i++) {
                    const barHeight = (dataArray[i] / 255) * canvas.height * 0.95;
                    const gradient = ctx.createLinearGradient(0, canvas.height, 0, 0);
                    gradient.addColorStop(0, "rgba(0, 242, 254, 0.2)");
                    gradient.addColorStop(0.5, "rgba(0, 242, 254, 0.8)");
                    gradient.addColorStop(1, "rgba(255, 0, 85, 0.95)");

                    ctx.fillStyle = gradient;
                    ctx.fillRect(x, canvas.height - barHeight, barWidth - 2, barHeight);
                    x += barWidth;
                }
            }
            draw();
        }

        // Determina com precisão qual vai ser a próxima música
        function getUpcomingTrack() {
            if (pendingQueue && pendingQueue.length > 0) {
                return pendingQueue[0];
            }
            if (!nowPlayingQueue || nowPlayingQueue.length === 0) return null;
            if (isShuffleEnabled) {
                const candidates = nowPlayingQueue.filter(t => !nowPlayingTrack || t.video_id !== nowPlayingTrack.video_id);
                return candidates.length > 0 ? candidates[0] : nowPlayingQueue[0];
            }
            const nextIdx = (nowPlayingIndex + 1) % nowPlayingQueue.length;
            return nowPlayingQueue[nextIdx] || null;
        }

        // Atualiza UI da faixa atual e da próxima faixa
        function updateUpcomingTrackUI() {
            const upcoming = getUpcomingTrack();
            const nextTitleEl = document.getElementById("nextPreviewTitle");
            const nextArtistEl = document.getElementById("nextPreviewArtist");
            const barStatusText = document.getElementById("barStatusText");

            if (upcoming) {
                const artistText = upcoming.artist ? upcoming.artist : (upcoming.category || "Fila");
                if (nextTitleEl) nextTitleEl.textContent = upcoming.title;
                if (nextArtistEl) nextArtistEl.textContent = artistText;

                if (barStatusText) {
                    const curTitle = nowPlayingTrack ? nowPlayingTrack.title : "Nenhuma";
                    barStatusText.innerHTML = `▶ Tocando: <strong class="playing">${escapeQuotes(curTitle)}</strong> &nbsp;•&nbsp; ⏭️ A Seguir: <strong class="next">${escapeQuotes(upcoming.title)}</strong>`;
                }
            } else {
                if (nextTitleEl) nextTitleEl.textContent = "Fim da fila";
                if (nextArtistEl) nextArtistEl.textContent = "Adicione mais músicas";
            }
        }

        // Inicializar Abas da Biblioteca
        function initTabs() {
            const tabsContainer = document.getElementById("tabsContainer");
            if (!tabsContainer) return;
            tabsContainer.innerHTML = "";
            CATEGORIES.forEach(cat => {
                const list = DATA[cat] || [];
                if (list.length === 0) return;
                const btn = document.createElement("button");
                btn.className = `tab-btn ${cat === browseCategory ? "active" : ""}`;
                btn.innerHTML = `<span>${ICONS[cat] || "🎵"} ${cat}</span><span class="count-badge">${list.length}</span>`;
                btn.onclick = () => selectCategoryToBrowse(cat);
                tabsContainer.appendChild(btn);
            });
        }

        function updateLibraryCounters() {
            let total = 0;
            CATEGORIES.forEach(cat => {
                total += (DATA[cat] || []).length;
            });
            const navText = document.getElementById("navLibraryText");
            if (navText) navText.textContent = `📚 Minha Biblioteca (${total})`;
            initTabs();
        }

        function setupTabsAutoScroll(wrapperId, leftBtnId, rightBtnId) {
            const wrapper = document.getElementById(wrapperId);
            const leftBtn = document.getElementById(leftBtnId);
            const rightBtn = document.getElementById(rightBtnId);
            if (!wrapper) return;

            let scrollInterval = null;
            function startScroll(speed) {
                if (scrollInterval) clearInterval(scrollInterval);
                scrollInterval = setInterval(() => {
                    wrapper.scrollLeft += speed;
                }, 16);
            }
            function stopScroll() {
                if (scrollInterval) {
                    clearInterval(scrollInterval);
                    scrollInterval = null;
                }
            }

            if (leftBtn) {
                leftBtn.onmouseenter = () => startScroll(-8);
                leftBtn.onmouseleave = stopScroll;
                leftBtn.onclick = () => { wrapper.scrollLeft -= 180; };
            }
            if (rightBtn) {
                rightBtn.onmouseenter = () => startScroll(8);
                rightBtn.onmouseleave = stopScroll;
                rightBtn.onclick = () => { wrapper.scrollLeft += 180; };
            }

            wrapper.addEventListener("mousemove", (e) => {
                const rect = wrapper.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const edgeZone = 40;
                if (mouseX < edgeZone) {
                    const ratio = 1 - (mouseX / edgeZone);
                    startScroll(-Math.round(4 + ratio * 8));
                } else if (mouseX > rect.width - edgeZone) {
                    const ratio = 1 - ((rect.width - mouseX) / edgeZone);
                    startScroll(Math.round(4 + ratio * 8));
                } else {
                    stopScroll();
                }
            });
            wrapper.addEventListener("mouseleave", stopScroll);
            wrapper.addEventListener("wheel", (e) => {
                if (e.deltaY !== 0) {
                    e.preventDefault();
                    wrapper.scrollLeft += e.deltaY;
                }
            }, { passive: false });
        }

        function setupListVerticalAutoScroll(listId) {
            const listEl = document.getElementById(listId);
            if (!listEl) return;

            let scrollInterval = null;
            function startScroll(speed) {
                if (scrollInterval) clearInterval(scrollInterval);
                scrollInterval = setInterval(() => {
                    listEl.scrollTop += speed;
                }, 16);
            }
            function stopScroll() {
                if (scrollInterval) {
                    clearInterval(scrollInterval);
                    scrollInterval = null;
                }
            }

            listEl.addEventListener("mousemove", (e) => {
                const rect = listEl.getBoundingClientRect();
                const mouseY = e.clientY - rect.top;
                const edgeZone = 60;

                if (mouseY < edgeZone && listEl.scrollTop > 0) {
                    const intensity = 1 - (mouseY / edgeZone);
                    startScroll(-Math.round(4 + intensity * 12));
                } else if (mouseY > rect.height - edgeZone && (listEl.scrollTop + listEl.clientHeight < listEl.scrollHeight - 5)) {
                    const intensity = 1 - ((rect.height - mouseY) / edgeZone);
                    startScroll(Math.round(4 + intensity * 12));
                } else {
                    stopScroll();
                }
            });
            listEl.addEventListener("mouseleave", stopScroll);
        }

        function selectCategoryToBrowse(category) {
            browseCategory = category;
            const container = document.getElementById("tabsContainer");
            if (container) {
                const btns = container.querySelectorAll(".tab-btn");
                btns.forEach(b => {
                    b.classList.toggle("active", b.textContent.includes(category));
                });
                const activeBtn = container.querySelector(".tab-btn.active");
                if (activeBtn) {
                    activeBtn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                }
            }
            const searchInput = document.getElementById("searchInput");
            if (searchInput && searchInput.value.trim() !== "") {
                handleLibrarySearch(searchInput.value);
            } else {
                renderList();
            }
        }

        function initSuggestionsTabs() {
            const container = document.getElementById("suggestionsTabsContainer");
            if (!container) return;
            container.innerHTML = "";
            CATEGORIES.forEach(cat => {
                const btn = document.createElement("button");
                btn.className = `tab-btn ${cat === currentSuggestionCategory ? "active" : ""}`;
                btn.innerHTML = `<span>${ICONS[cat] || "🎵"} ${cat}</span>`;
                btn.onclick = () => selectSuggestionCategory(cat);
                container.appendChild(btn);
            });
        }

        function selectSuggestionCategory(category) {
            isRadioActive = false;
            currentSuggestionCategory = category;
            const container = document.getElementById("suggestionsTabsContainer");
            if (container) {
                const btns = container.querySelectorAll(".tab-btn");
                btns.forEach(b => {
                    b.classList.toggle("active", b.textContent.includes(category));
                });
                const activeBtn = container.querySelector(".tab-btn.active");
                if (activeBtn) {
                    activeBtn.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
                }
            }
            updateSuggestionHeader();
            if (suggestionsByGenre[category] && suggestionsByGenre[category].length > 0) {
                renderSuggestionsList(suggestionsByGenre[category]);
            } else {
                fetchFreshSuggestionsForCurrentGenre();
            }
        }

        // Rádio da Faixa: Buscar Faixas Parecidas com IA baseado no ritmo e BPM
        async function openRadioForCurrentTrack() {
            if (!nowPlayingTrack) {
                showToast("Selecione ou reproduza uma música primeiro para buscar faixas parecidas.");
                return;
            }
            findSimilarToTrack(nowPlayingTrack);
        }

        async function findSimilarToTrack(track) {
            if (!track || !track.title) return;
            const bpm = track.bpm || detectBpmJs(track.title, track.category);
            const title = track.title;
            const artist = track.artist || "";
            const category = track.category || "Personalizada";
            const videoId = track.video_id || "";

            showToast(`📻 Buscando faixas parecidas com "${title}" (${bpm} BPM)...`);
            isRadioActive = true;
            switchView("suggestions");

            const headerTitle = document.getElementById("suggestionActiveGenreTitle");
            const headerSub = document.getElementById("suggestionSubtext");
            const badge = document.getElementById("suggestionCountBadge");
            const btn = document.getElementById("btnRefreshSuggestions");

            if (headerTitle) headerTitle.innerHTML = `📻 Faixas Parecidas: <em>${escapeHtml(title)}</em>`;
            if (headerSub) headerSub.innerHTML = `Músicas no mesmo ritmo e gênero (<strong>${bpm} BPM</strong> • ${escapeHtml(category)}).`;
            if (badge) badge.textContent = "Minerando com IA...";
            if (btn) btn.innerHTML = `<span>🔄 Buscar Mais no Mesmo Ritmo (${bpm} BPM)</span>`;

            const cacheKey = (videoId || title) + "_rhythm";
            if (radioSuggestionsCache[cacheKey] && radioSuggestionsCache[cacheKey].length > 0) {
                renderSuggestionsList(radioSuggestionsCache[cacheKey]);
                if (badge) badge.textContent = `${radioSuggestionsCache[cacheKey].length} faixas parecidas (${bpm} BPM)`;
                return;
            }

            showSuggestionsSkeleton();

            try {
                const res = await fetch(`/api/suggestions/related?title=${encodeURIComponent(title)}&artist=${encodeURIComponent(artist)}&category=${encodeURIComponent(category)}&video_id=${encodeURIComponent(videoId)}&bpm=${bpm}`);
                const data = await res.json();
                const tracks = data.tracks || [];

                radioSuggestionsCache[cacheKey] = tracks;
                renderSuggestionsList(tracks);
                if (badge) badge.textContent = `${tracks.length} faixas parecidas (${bpm} BPM)`;
            } catch (e) {
                console.error("Erro ao buscar faixas parecidas:", e);
                const container = document.getElementById("suggestionsList");
                if (container) container.innerHTML = `<div style="color: #ff5555; text-align: center; padding: 25px;">Erro ao buscar faixas parecidas. <button class="btn-sync-yt" style="margin-top:10px;" onclick="findSimilarToTrack(${JSON.stringify(track).replace(/"/g, '&quot;')})">Tentar Novamente</button></div>`;
            }
        }

        async function fetchRadioSuggestions() {
            if (nowPlayingTrack) {
                await findSimilarToTrack(nowPlayingTrack);
            }
        }

        function updateSuggestionHeader() {
            const titleEl = document.getElementById("suggestionActiveGenreTitle");
            const subEl = document.getElementById("suggestionSubtext");
            const badge = document.getElementById("suggestionCountBadge");
            const btn = document.getElementById("btnRefreshSuggestions");

            if (isRadioActive) return;

            if (titleEl) titleEl.textContent = `✨ Novidades: ${currentSuggestionCategory}`;
            if (subEl) subEl.innerHTML = `Músicas buscadas em tempo real no YouTube para este estilo e ritmo. <strong>Nunca se repetem</strong>.`;
            const currentList = suggestionsByGenre[currentSuggestionCategory] || [];
            if (badge) badge.textContent = currentList.length > 0 ? `${currentList.length} inéditas` : "Carregando...";
            if (btn) btn.innerHTML = `<span>🔄 Buscar Mais Novas Músicas (Sem Repetir)</span>`;
        }

        function showSuggestionsSkeleton() {
            const container = document.getElementById("suggestionsList");
            if (!container) return;
            container.innerHTML = `
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
                <div class="skeleton-card"></div>
            `;
        }

        // Buscar sugestões sem repetição para o gênero atual
        async function fetchFreshSuggestionsForCurrentGenre() {
            if (isRadioActive) {
                delete radioSuggestionsCache[(nowPlayingTrack.video_id || nowPlayingTrack.title) + "_rhythm"];
                openRadioForCurrentTrack();
                return;
            }

            const container = document.getElementById("suggestionsList");
            const badge = document.getElementById("suggestionCountBadge");
            const btn = document.getElementById("btnRefreshSuggestions");

            if (badge) badge.textContent = "Buscando...";
            if (btn) btn.innerHTML = `<span>⏳ Buscando no YouTube...</span>`;
            showSuggestionsSkeleton();

            try {
                const res = await fetch("/api/suggestions/discover", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ category: currentSuggestionCategory })
                });
                const data = await res.json();
                const freshTracks = data.tracks || [];

                suggestionsByGenre[currentSuggestionCategory] = freshTracks;
                renderSuggestionsList(freshTracks);

                if (badge) badge.textContent = `${freshTracks.length} inéditas`;
            } catch (e) {
                if (container) container.innerHTML = `<div style="color: #ff5555; text-align: center; padding: 25px;">Erro ao carregar sugestões. Clique no botão acima para tentar novamente.</div>`;
            } finally {
                if (btn) btn.innerHTML = `<span>🔄 Buscar Mais Novas Músicas (Sem Repetir)</span>`;
            }
        }

        async function resetSeenHistory() {
            if (confirm("Deseja resetar o histórico de músicas vistas? As sugestões passadas poderão voltar a ser exibidas.")) {
                try {
                    await fetch("/api/suggestions/reset-seen", { method: "POST" });
                    showToast("Histórico de sugestões resetado!");
                    if (isRadioActive) openRadioForCurrentTrack();
                    else fetchFreshSuggestionsForCurrentGenre();
                } catch (e) {}
            }
        }

        function switchView(view) {
            browseView = view;
            const navLib = document.getElementById("navLibrary");
            const navSearch = document.getElementById("navSearch");
            const navSugg = document.getElementById("navSuggestions");
            const navQ = document.getElementById("navQueue");

            if (navLib) navLib.className = `nav-btn ${view === "library" ? "active" : ""}`;
            if (navSearch) navSearch.className = `nav-btn ${view === "search" ? "active" : ""}`;
            if (navSugg) navSugg.className = `nav-btn ${view === "suggestions" ? "active" : ""}`;
            if (navQ) navQ.className = `nav-btn ${view === "queue" ? "active" : ""}`;

            const paneLib = document.getElementById("paneLibrary");
            const paneSearch = document.getElementById("paneSearch");
            const paneSugg = document.getElementById("paneSuggestions");
            const paneQ = document.getElementById("paneQueue");

            if (paneLib) paneLib.style.display = view === "library" ? "flex" : "none";
            if (paneSearch) paneSearch.style.display = view === "search" ? "flex" : "none";
            if (paneSugg) paneSugg.style.display = view === "suggestions" ? "flex" : "none";
            if (paneQ) paneQ.style.display = view === "queue" ? "flex" : "none";

            setupListVerticalAutoScroll("suggestionsList");
            setupListVerticalAutoScroll("searchResultsList");

            if (view === "library") {
                renderList();
            } else if (view === "search") {
                renderSearchResults();
                setTimeout(() => {
                    const input = document.getElementById("freeSearchInput");
                    if (input && !input.value) input.focus();
                }, 50);
            } else if (view === "suggestions") {
                initSuggestionsTabs();
                updateSuggestionHeader();
                if (isRadioActive) {
                    fetchRadioSuggestions();
                } else if (!suggestionsByGenre[currentSuggestionCategory]) {
                    fetchFreshSuggestionsForCurrentGenre();
                } else {
                    renderSuggestionsList(suggestionsByGenre[currentSuggestionCategory]);
                }
            } else if (view === "queue") {
                loadQueue();
            }
        }

        // Renderiza a lista de músicas exibindo:
        // 1. Status 'TOCANDO AGORA' com animação na música atual
        // 2. Status '✨ ADICIONADA AGORA' na última música que foi favoritada
        // 3. Status 'A SEGUIR (PRÓXIMA)' na próxima música a ser tocada
        function renderList(filteredTracks = null) {
            const listContainer = document.getElementById("trackList");
            if (!listContainer) return;
            listContainer.innerHTML = "";
            const tracks = filteredTracks !== null ? filteredTracks : (DATA[browseCategory] || []);

            if (tracks.length === 0) {
                listContainer.innerHTML = '<div style="color: var(--text-dim); text-align: center; padding: 25px;">Nenhuma música encontrada.</div>';
                return;
            }

            const currentVideoId = nowPlayingTrack ? nowPlayingTrack.video_id : null;
            const upcomingTrack = getUpcomingTrack();
            const upcomingVideoId = upcomingTrack ? upcomingTrack.video_id : null;
            const queuedIds = new Set(pendingQueue.map(t => t.video_id));

            tracks.forEach((t, index) => {
                const isPlaying = (t.video_id === currentVideoId);
                const isLastAdded = (!isPlaying && (t.video_id === lastAddedVideoId || t.addedJustNow));
                const isNext = (!isPlaying && !isLastAdded && t.video_id === upcomingVideoId);
                const isQueued = queuedIds.has(t.video_id);

                let cardClasses = "track-card";
                if (isPlaying) cardClasses += " playing-now";
                else if (isLastAdded) cardClasses += " next-up";
                else if (isNext) cardClasses += " next-up";

                const card = document.createElement("div");
                card.className = cardClasses;

                let statusBadgeHtml = "";
                if (isPlaying) {
                    statusBadgeHtml = `
                        <div class="badge-now-playing">
                            <span class="eq-anim-bars"><span></span><span></span><span></span></span>
                            <span>TOCANDO AGORA</span>
                        </div>
                    `;
                } else if (isLastAdded) {
                    statusBadgeHtml = `
                        <div class="badge-added-now">
                            <span>✨ ADICIONADA AGORA</span>
                        </div>
                    `;
                } else if (isNext) {
                    statusBadgeHtml = `
                        <div class="badge-next-up">
                            <span>⏭️ A SEGUIR (PRÓXIMA)</span>
                        </div>
                    `;
                }

                const artistText = t.artist ? t.artist + " • " + (t.source || "") : (t.source || "");

                card.innerHTML = `
                    <div class="track-meta" onclick="startPlaybackFromLibrary('${browseCategory}', ${index})">
                        <div class="track-card-title">
                            <span>${index + 1}. ${t.title}</span>
                            ${statusBadgeHtml}
                        </div>
                        <div class="track-card-artist">${artistText}</div>
                    </div>
                    <div class="card-actions">
                        <button class="btn-similar-card" onclick="findSimilarToTrack(${JSON.stringify(t).replace(/"/g, '&quot;')})" title="Buscar músicas semelhantes no mesmo ritmo e BPM com IA">
                            📻 Parecidas
                        </button>
                        ${isQueued 
                            ? `<button class="btn-add-queue added">✓ Na Fila</button>`
                            : `<button class="btn-add-queue" onclick="addToQueue(${JSON.stringify(t).replace(/"/g, '&quot;')})">+ Fila</button>`
                        }
                    </div>
                `;
                listContainer.appendChild(card);
            });

            updateUpcomingTrackUI();
        }

        // ADICIONAR MÚSICA À PLAYLIST COM ANIMAÇÃO FLY-OUT E STATUS DINÂMICO
        async function addTrackToPlaylist(track, cardElement) {
            if (!track || !track.video_id) return;

            // 1. Efeito visual: animação fly-out (desliza e some suavemente da lista de recomendados)
            if (cardElement) {
                cardElement.classList.add("card-fly-out");
            }

            const targetCategory = track.category || currentSuggestionCategory || "Mega Funk & Ritmadas";

            try {
                // 2. Salva no complete_library.json no backend
                const res = await fetch("/api/library/add", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        video_id: track.video_id,
                        title: track.title,
                        artist: track.artist || "",
                        category: targetCategory,
                        source: "Sugestões (Favoritada)"
                    })
                });
                const data = await res.json();

                // 3. Adiciona na biblioteca frontend DATA[targetCategory] no topo
                if (!DATA[targetCategory]) DATA[targetCategory] = [];
                if (!DATA[targetCategory].some(t => t.video_id === track.video_id)) {
                    const newTrackObj = {
                        title: track.title,
                        artist: track.artist || "",
                        category: targetCategory,
                        video_id: track.video_id,
                        source: "Favoritada",
                        addedJustNow: true
                    };
                    DATA[targetCategory].unshift(newTrackObj);
                }

                // 4. Marca o ID desta música como a última adicionada
                lastAddedVideoId = track.video_id;
                localStorage.setItem("pref_last_added_id", lastAddedVideoId);

                // 5. Remove da lista de sugestões após o término da animação
                setTimeout(() => {
                    if (cardElement && cardElement.parentNode) {
                        cardElement.parentNode.removeChild(cardElement);
                    }
                    if (suggestionsByGenre[currentSuggestionCategory]) {
                        suggestionsByGenre[currentSuggestionCategory] = suggestionsByGenre[currentSuggestionCategory].filter(t => t.video_id !== track.video_id);
                        updateSuggestionHeader();
                    }
                }, 380);

                // 6. Atualiza contadores da biblioteca
                updateLibraryCounters();
                renderList();

                showToast(`✨ "${track.title}" adicionada à sua playlist de ${targetCategory}!`);
            } catch (err) {
                console.error("Erro ao adicionar faixa à biblioteca:", err);
                showToast("Erro ao adicionar faixa. Tente novamente.");
            }
        }

        // SINCRONIZAR COM O YOUTUBE (FAB FLUTUANTE)
        async function triggerYouTubeSync() {
            const btn = document.getElementById("floatingSyncBtn");
            const btnText = document.getElementById("syncBtnText");

            if (btn) btn.classList.add("syncing");
            if (btnText) btnText.textContent = "Sincronizando...";
            showToast("🔄 Sincronizando com sua playlist no YouTube...");

            try {
                const res = await fetch("/api/sync-youtube", { method: "POST" });
                const data = await res.json();
                
                if (data.success || data.playlist_url) {
                    showToast("✅ Playlist sincronizada com o YouTube com sucesso!", 3500);
                } else {
                    showToast("Erro na sincronização: " + (data.message || "Tente novamente."));
                }
            } catch (e) {
                showToast("Erro na sincronização. Tente novamente.");
            } finally {
                setTimeout(() => {
                    if (btn) btn.classList.remove("syncing");
                    if (btnText) btnText.textContent = "Sincronizar com YouTube";
                }, 1500);
            }
        }

        // Iniciar reprodução com Crossfade suave quando já houver música tocando
        function startPlaybackFromLibrary(categoryName, index) {
            const queue = DATA[categoryName] || [];
            if (index < 0 || index >= queue.length) return;
            
            nowPlayingQueue = queue;
            nowPlayingCategoryName = categoryName;
            nowPlayingIndex = index;
            const nextTrack = queue[index];

            initWebAudio();
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }

            const activeP = getActivePlayer();
            const isCurrentlyPlaying = (engineMode === "audio" && audioDeckA && !audioDeckA.paused) || 
                (engineMode === "video" && activeP && typeof activeP.getPlayerState === "function" && 
                 (activeP.getPlayerState() === YT.PlayerState.PLAYING || activeP.getPlayerState() === YT.PlayerState.BUFFERING));

            if (isCurrentlyPlaying && crossfadeSeconds > 0 && nowPlayingTrack && nowPlayingTrack.video_id !== nextTrack.video_id) {
                triggerCrossfade(nextTrack);
            } else {
                playTrackInstant(nextTrack);
            }
            renderAllActiveLists();
        }

        // Faixa customizada (Sugestões ou Fila) com Crossfade suave
        function playCustomTrack(videoId, title, artist, category, source) {
            const customTrack = {
                video_id: videoId,
                title: title,
                artist: artist,
                category: category || "Personalizada",
                source: source || "Geral"
            };
            nowPlayingQueue = [customTrack];
            nowPlayingIndex = 0;
            nowPlayingCategoryName = category || "Personalizada";

            initWebAudio();
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }

            const activeP = getActivePlayer();
            const isCurrentlyPlaying = (engineMode === "audio" && audioDeckA && !audioDeckA.paused) || 
                (engineMode === "video" && activeP && typeof activeP.getPlayerState === "function" && 
                 (activeP.getPlayerState() === YT.PlayerState.PLAYING || activeP.getPlayerState() === YT.PlayerState.BUFFERING));

            if (isCurrentlyPlaying && crossfadeSeconds > 0 && nowPlayingTrack && nowPlayingTrack.video_id !== customTrack.video_id) {
                triggerCrossfade(customTrack);
            } else {
                playTrackInstant(customTrack);
            }
            renderAllActiveLists();
        }

        // Retorna o player ativo e o standby
        function getActivePlayer() {
            return activeDeck === "A" ? playerA : playerB;
        }

        function getStandbyPlayer() {
            return activeDeck === "A" ? playerB : playerA;
        }

        function getActiveDeckEl() {
            return document.getElementById(activeDeck === "A" ? "deckA" : "deckB");
        }

        function getStandbyDeckEl() {
            return document.getElementById(activeDeck === "A" ? "deckB" : "deckA");
        }

        function getActiveAudioDeck() {
            return activeDeck === "A" ? audioDeckA : audioDeckB;
        }

        function getStandbyAudioDeck() {
            return activeDeck === "A" ? audioDeckB : audioDeckA;
        }

        function cancelTransition() {
            if (crossfadeTimer) {
                clearInterval(crossfadeTimer);
                crossfadeTimer = null;
            }
            isTransitioning = false;
            hideCrossfadeIndicator();
        }

        // Executar faixa instantânea
        function playTrackInstant(track) {
            if (!track) return;
            hideToast();
            cancelTransition();

            hasFadedCurrentTrack = false;
            prewarmedUpcomingId = "";
            nowPlayingTrack = track;
            updateTrackInfoUI(track);

            if (track && track.video_id && !trackDurations[track.video_id]) {
                fetch(`/api/audio/info?id=${track.video_id}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.duration) {
                            trackDurations[track.video_id] = data.duration;
                            if (nowPlayingTrack && nowPlayingTrack.video_id === track.video_id) {
                                nowPlayingTrack.duration = data.duration;
                            }
                        }
                    }).catch(() => {});
            }

            const startSec = Math.max(0, parseFloat(introSkipSeconds) || 0);

            // Modo Áudio HD (Equalizador + 200% VLC + Zero Restrições)
            if (engineMode === "audio") {
                initWebAudio();
                if (audioCtx && audioCtx.state === "suspended") {
                    audioCtx.resume();
                }

                const curAudio = getActiveAudioDeck();
                const stdAudio = getStandbyAudioDeck();

                if (stdAudio) {
                    stdAudio.pause();
                    stdAudio.currentTime = 0;
                }

                if (deckGainA && deckGainB && audioCtx) {
                    const now = audioCtx.currentTime;
                    if (activeDeck === "A") {
                        deckGainA.gain.cancelScheduledValues(now);
                        deckGainA.gain.setValueAtTime(0.0, now);
                        deckGainA.gain.linearRampToValueAtTime(1.0, now + 0.15);
                        deckGainB.gain.cancelScheduledValues(now);
                        deckGainB.gain.setValueAtTime(0.0, now);
                    } else {
                        deckGainB.gain.cancelScheduledValues(now);
                        deckGainB.gain.setValueAtTime(0.0, now);
                        deckGainB.gain.linearRampToValueAtTime(1.0, now + 0.15);
                        deckGainA.gain.cancelScheduledValues(now);
                        deckGainA.gain.setValueAtTime(0.0, now);
                    }
                }

                if (curAudio) {
                    curAudio.src = `/api/audio/stream?id=${track.video_id}`;
                    curAudio.currentTime = startSec;
                    curAudio.play().then(() => {
                        if (startSec > 0 && Math.abs(curAudio.currentTime - startSec) > 0.6) {
                            curAudio.currentTime = startSec;
                        }
                        updatePlayPauseButtons(true);
                    }).catch(err => {
                        console.warn("Autoplay aguardando interação do usuário:", err);
                    });
                }

                // Pausa YouTube IFrame
                const activeP = getActivePlayer();
                if (activeP && typeof activeP.pauseVideo === "function") {
                    try { activeP.pauseVideo(); activeP.setVolume(0); } catch (e) {}
                }

                const visScreen = document.getElementById("visualizerScreen");
                if (visScreen) visScreen.style.display = "flex";
            } else {
                // Modo Vídeo Clipe YouTube
                if (audioDeckA) audioDeckA.pause();
                if (audioDeckB) audioDeckB.pause();

                const visScreen = document.getElementById("visualizerScreen");
                if (visScreen) visScreen.style.display = "none";

                const activeP = getActivePlayer();
                const standbyP = getStandbyPlayer();
                const activeEl = getActiveDeckEl();
                const standbyEl = getStandbyDeckEl();

                try {
                    if (standbyP && typeof standbyP.pauseVideo === "function") {
                        standbyP.pauseVideo();
                        standbyP.setVolume(0);
                    }
                } catch (e) {}

                if (activeEl) {
                    activeEl.style.opacity = "1";
                    activeEl.style.zIndex = "2";
                }
                if (standbyEl) {
                    standbyEl.style.opacity = "0";
                    standbyEl.style.zIndex = "1";
                }

                if (activeP && typeof activeP.loadVideoById === "function") {
                    try {
                        if (isMuted) activeP.mute();
                        else {
                            activeP.unMute();
                            activeP.setVolume(Math.min(100, masterVolume));
                        }
                        activeP.loadVideoById(track.video_id, startSec);
                        if (startSec > 0 && typeof activeP.seekTo === "function") {
                            try { activeP.seekTo(startSec, true); } catch (e) {}
                        }
                        activeP.playVideo();
                    } catch (e) {}
                }
            }

            startTimeMonitor();
            updateUpcomingTrackUI();
        }

        // Transição Dupla Crossfade
        function triggerCrossfade(nextTrack) {
            if (!nextTrack || isTransitioning) return;
            cancelTransition();

            isTransitioning = true;
            hasFadedCurrentTrack = true;
            hideToast();

            showCrossfadeIndicator();
            const startSec = Math.max(0, parseFloat(introSkipSeconds) || 0);
            const durationMs = (crossfadeSeconds || 4) * 1000;

            nowPlayingTrack = nextTrack;
            updateTrackInfoUI(nextTrack);
            updateUpcomingTrackUI();
            renderList();

            if (nextTrack && nextTrack.video_id && !trackDurations[nextTrack.video_id]) {
                fetch(`/api/audio/info?id=${nextTrack.video_id}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data && data.duration) trackDurations[nextTrack.video_id] = data.duration;
                    }).catch(() => {});
            }

            if (engineMode === "audio") {
                initWebAudio();
                if (audioCtx && audioCtx.state === "suspended") {
                    audioCtx.resume();
                }

                const fromAudio = getActiveAudioDeck();
                const toAudio = getStandbyAudioDeck();
                const fromGain = activeDeck === "A" ? deckGainA : deckGainB;
                const toGain = activeDeck === "A" ? deckGainB : deckGainA;

                // Garante que o deck que entra comece em 0 e o atual em 1 suavemente
                if (fromGain && audioCtx) {
                    fromGain.gain.cancelScheduledValues(audioCtx.currentTime);
                    fromGain.gain.setValueAtTime(1.0, audioCtx.currentTime);
                }
                if (toGain && audioCtx) {
                    toGain.gain.cancelScheduledValues(audioCtx.currentTime);
                    toGain.gain.setValueAtTime(0.0, audioCtx.currentTime);
                }

                if (toAudio) {
                    toAudio.src = `/api/audio/stream?id=${nextTrack.video_id}`;
                    toAudio.currentTime = startSec;
                    toAudio.play().then(() => {
                        if (startSec > 0 && Math.abs(toAudio.currentTime - startSec) > 0.6) {
                            toAudio.currentTime = startSec;
                        }
                    }).catch(() => {});
                }

                const stepInterval = 40;
                const totalSteps = Math.max(1, durationMs / stepInterval);
                let currentStep = 0;

                crossfadeTimer = setInterval(() => {
                    currentStep++;
                    const progress = currentStep / totalSteps;

                    const fromVol = Math.max(0, 1 - progress);
                    const toVol = Math.min(1, progress);
                    if (fromGain) fromGain.gain.value = fromVol;
                    if (toGain) toGain.gain.value = toVol;

                    // Animação em tempo real do DJ Crossfader Slider
                    const knobPct = (activeDeck === "A") ? (progress * 100) : ((1 - progress) * 100);
                    const faderKnob = document.getElementById("djFaderKnob");
                    const faderFill = document.getElementById("djFaderFill");
                    const balanceText = document.getElementById("crossfaderBalanceText");
                    const meterA = document.getElementById("meterA");
                    const meterB = document.getElementById("meterB");

                    if (faderKnob) faderKnob.style.left = `${knobPct}%`;
                    if (faderFill) faderFill.style.width = `${knobPct}%`;
                    if (balanceText) {
                        const pctA = Math.round((activeDeck === "A" ? (1 - progress) : progress) * 100);
                        const pctB = Math.round((activeDeck === "A" ? progress : (1 - progress)) * 100);
                        balanceText.textContent = `Deck A ${pctA}% ➔ ${pctB}% Deck B`;
                    }
                    if (meterA && meterB) {
                        meterA.style.width = `${(activeDeck === "A" ? fromVol : toVol) * 100}%`;
                        meterB.style.width = `${(activeDeck === "A" ? toVol : fromVol) * 100}%`;
                    }

                    if (currentStep >= totalSteps) {
                        clearInterval(crossfadeTimer);
                        crossfadeTimer = null;

                        activeDeck = activeDeck === "A" ? "B" : "A";
                        if (fromAudio) {
                            fromAudio.pause();
                            fromAudio.currentTime = 0;
                        }

                        nowPlayingTrack = nextTrack;
                        updateTrackInfoUI(nextTrack);
                        hideCrossfadeIndicator();
                        isTransitioning = false;
                        hasFadedCurrentTrack = false;
                        prewarmedUpcomingId = "";
                        startTimeMonitor();
                        renderAllActiveLists();
                        updateUpcomingTrackUI();
                        updateDjMixerUI();
                    }
                }, stepInterval);

            } else {
                // YouTube Crossfade
                const fromPlayer = getActivePlayer();
                const toPlayer = getStandbyPlayer();
                const fromDeckEl = getActiveDeckEl();
                const toDeckEl = getStandbyDeckEl();

                try {
                    toPlayer.unMute();
                    toPlayer.setVolume(0);
                    if (typeof toPlayer.loadVideoById === "function") {
                        toPlayer.loadVideoById(nextTrack.video_id, startSec);
                        if (startSec > 0 && typeof toPlayer.seekTo === "function") {
                            try { toPlayer.seekTo(startSec, true); } catch (e) {}
                        }
                        toPlayer.playVideo();
                    }
                } catch (e) {}

                const ytMaxVol = Math.min(100, masterVolume);
                const stepInterval = 40;
                const totalSteps = Math.max(1, durationMs / stepInterval);
                let currentStep = 0;

                if (toDeckEl) toDeckEl.style.zIndex = "2";
                if (fromDeckEl) fromDeckEl.style.zIndex = "1";

                crossfadeTimer = setInterval(() => {
                    currentStep++;
                    const progress = currentStep / totalSteps;

                    const volFrom = Math.round(ytMaxVol * (1 - progress));
                    const volTo = Math.round(ytMaxVol * progress);

                    try {
                        if (!isMuted) {
                            fromPlayer.setVolume(Math.max(0, volFrom));
                            toPlayer.setVolume(Math.min(ytMaxVol, volTo));
                        }
                        if (fromDeckEl) fromDeckEl.style.opacity = (1 - progress).toFixed(2);
                        if (toDeckEl) toDeckEl.style.opacity = progress.toFixed(2);
                    } catch (e) {}

                    if (currentStep >= totalSteps) {
                        clearInterval(crossfadeTimer);
                        crossfadeTimer = null;
                        
                        activeDeck = activeDeck === "A" ? "B" : "A";
                        if (fromDeckEl) fromDeckEl.style.opacity = "0";
                        if (toDeckEl) toDeckEl.style.opacity = "1";

                        try {
                            fromPlayer.pauseVideo();
                            fromPlayer.setVolume(0);
                            if (isMuted) toPlayer.mute();
                            else {
                                toPlayer.unMute();
                                toPlayer.setVolume(ytMaxVol);
                            }
                        } catch (e) {}

                        hideCrossfadeIndicator();
                        isTransitioning = false;
                        hasFadedCurrentTrack = false;
                        prewarmedUpcomingId = "";
                        startTimeMonitor();
                        renderList();
                        updateUpcomingTrackUI();
                    }
                }, stepInterval);
            }
        }

        // SELEÇÃO DA PARTE DA MÚSICA (SEEK BAR) NO PLAYER PRINCIPAL
        
        // SPOTIFY DJ MIXER INTERFACE CONTROLLER
        function updateDjMixerUI() {
            const deckACard = document.getElementById("djDeckACard");
            const deckBCard = document.getElementById("djDeckBCard");
            const deckATag = document.getElementById("deckATag");
            const deckBTag = document.getElementById("deckBTag");
            const vinylA = document.getElementById("vinylA");
            const vinylB = document.getElementById("vinylB");
            const deckATitle = document.getElementById("deckATitle");
            const deckAArtist = document.getElementById("deckAArtist");
            const deckABpm = document.getElementById("deckABpm");
            const deckBTitle = document.getElementById("deckBTitle");
            const deckBArtist = document.getElementById("deckBArtist");
            const deckBBpm = document.getElementById("deckBBpm");
            const meterA = document.getElementById("meterA");
            const meterB = document.getElementById("meterB");
            const faderKnob = document.getElementById("djFaderKnob");
            const faderFill = document.getElementById("djFaderFill");
            const syncBadge = document.getElementById("djBpmSyncBadge");
            const balanceText = document.getElementById("crossfaderBalanceText");

            const upcoming = getUpcomingTrack();
            const curBpm = (nowPlayingTrack && nowPlayingTrack.bpm) ? nowPlayingTrack.bpm : 135;
            const nextBpm = (upcoming && upcoming.bpm) ? upcoming.bpm : curBpm;

            if (activeDeck === "A") {
                if (deckACard) deckACard.classList.add("active-deck");
                if (deckBCard) deckBCard.classList.remove("active-deck");
                if (deckATag) { deckATag.className = "deck-tag active"; deckATag.textContent = "DECK A"; }
                if (deckBTag) { deckBTag.className = "deck-tag"; deckBTag.textContent = "DECK B"; }
                if (vinylA) vinylA.classList.add("spinning");
                if (vinylB) vinylB.classList.remove("spinning");

                if (deckATitle) deckATitle.textContent = nowPlayingTrack ? nowPlayingTrack.title : "Tocando agora";
                if (deckAArtist) deckAArtist.textContent = nowPlayingTrack ? (nowPlayingTrack.artist || nowPlayingTrack.category) : "-";
                if (deckABpm) deckABpm.textContent = `${curBpm} BPM`;

                if (deckBTitle) deckBTitle.textContent = upcoming ? upcoming.title : "Fim da fila";
                if (deckBArtist) deckBArtist.textContent = upcoming ? (upcoming.artist || upcoming.category) : "-";
                if (deckBBpm) deckBBpm.textContent = `${nextBpm} BPM`;

                if (meterA) meterA.style.width = "100%";
                if (meterB) meterB.style.width = "0%";
                if (!isTransitioning) {
                    if (faderKnob) faderKnob.style.left = "0%";
                    if (faderFill) faderFill.style.width = "0%";
                    if (balanceText) balanceText.textContent = `Deck A 100% • Crossfade: ${crossfadeSeconds}s`;
                }
            } else {
                if (deckBCard) deckBCard.classList.add("active-deck");
                if (deckACard) deckACard.classList.remove("active-deck");
                if (deckBTag) { deckBTag.className = "deck-tag active"; deckBTag.textContent = "DECK B"; }
                if (deckATag) { deckATag.className = "deck-tag"; deckATag.textContent = "DECK A"; }
                if (vinylB) vinylB.classList.add("spinning");
                if (vinylA) vinylA.classList.remove("spinning");

                if (deckBTitle) deckBTitle.textContent = nowPlayingTrack ? nowPlayingTrack.title : "Tocando agora";
                if (deckBArtist) deckBArtist.textContent = nowPlayingTrack ? (nowPlayingTrack.artist || nowPlayingTrack.category) : "-";
                if (deckBBpm) deckBBpm.textContent = `${curBpm} BPM`;

                if (deckATitle) deckATitle.textContent = upcoming ? upcoming.title : "Fim da fila";
                if (deckAArtist) deckAArtist.textContent = upcoming ? (upcoming.artist || upcoming.category) : "-";
                if (deckABpm) deckABpm.textContent = `${nextBpm} BPM`;

                if (meterB) meterB.style.width = "100%";
                if (meterA) meterA.style.width = "0%";
                if (!isTransitioning) {
                    if (faderKnob) faderKnob.style.left = "100%";
                    if (faderFill) faderFill.style.width = "100%";
                    if (balanceText) balanceText.textContent = `Deck B 100% • Crossfade: ${crossfadeSeconds}s`;
                }
            }

            if (syncBadge) {
                syncBadge.textContent = `⚡ Sincronia: ~${curBpm} BPM`;
            }
        }

        // Executar com Fade-In suave (evita estalo ao iniciar do zero)
        function playTrackInstantWithFadeIn(track) {
            playTrackInstant(track);
            if (engineMode === "audio" && audioCtx) {
                const curGain = (activeDeck === "A" ? deckGainA : deckGainB);
                if (curGain) {
                    curGain.gain.setValueAtTime(0.0, audioCtx.currentTime);
                    curGain.gain.linearRampToValueAtTime(1.0, audioCtx.currentTime + 0.8);
                }
            }
            updateDjMixerUI();
        }

        // Centralizador de reprodução: Garante Crossfade em QUALQUER música selecionada!
        function playTrackByObject(track) {
            if (!track) return;
            const cat = track.category || browseCategory;
            if (DATA[cat]) {
                nowPlayingQueue = DATA[cat];
                nowPlayingCategoryName = cat;
                const foundIdx = nowPlayingQueue.findIndex(t => t.video_id === track.video_id);
                nowPlayingIndex = foundIdx !== -1 ? foundIdx : 0;
            } else {
                nowPlayingQueue = [track];
                nowPlayingIndex = 0;
                nowPlayingCategoryName = "Personalizada";
            }

            initWebAudio();
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }

            const curAudio = getActiveAudioDeck();
            const activeP = getActivePlayer();
            const isPlaying = (engineMode === "audio" && curAudio && !curAudio.paused && curAudio.currentTime > 0) || 
                              (engineMode === "video" && activeP && typeof activeP.getPlayerState === "function" && 
                               (activeP.getPlayerState() === YT.PlayerState.PLAYING || activeP.getPlayerState() === YT.PlayerState.BUFFERING));

            if (isPlaying && crossfadeSeconds > 0 && nowPlayingTrack && nowPlayingTrack.video_id !== track.video_id) {
                triggerCrossfade(track);
            } else {
                playTrackInstantWithFadeIn(track);
            }
            renderAllActiveLists();
        }

        function playTrackByVideoId(videoId) {
            let found = null;
            CATEGORIES.forEach(cat => {
                if (!found && DATA[cat]) {
                    found = DATA[cat].find(t => t.video_id === videoId);
                }
            });
            if (!found && pendingQueue) {
                found = pendingQueue.find(t => t.video_id === videoId);
            }
            if (!found && suggestionsByGenre[currentSuggestionCategory]) {
                found = suggestionsByGenre[currentSuggestionCategory].find(t => t.video_id === videoId);
            }
            if (found) {
                playTrackByObject(found);
            }
        }

        function startPlaybackFromLibrary(categoryName, index) {
            const queue = DATA[categoryName] || [];
            if (index >= 0 && index < queue.length) {
                playTrackByObject(queue[index]);
            }
        }

        function playCustomTrack(videoId, title, artist, category, source, bpm) {
            const customTrack = {
                video_id: videoId,
                title: title,
                artist: artist,
                category: category || "Personalizada",
                source: source || "Geral",
                bpm: bpm || 135
            };
            playTrackByObject(customTrack);
        }

        function handleSeekClick(e) {
            const track = document.getElementById("progressTrack");
            if (!track) return;
            const rect = track.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            const percentage = Math.max(0, Math.min(1, clickX / rect.width));
            seekToPercentage(percentage);
        }

        function seekToPercentage(pct) {
            let dur = 0;
            if (engineMode === "audio") {
                const curAudio = getActiveAudioDeck();
                if (curAudio && curAudio.duration) {
                    dur = curAudio.duration;
                    curAudio.currentTime = pct * dur;
                }
            } else {
                const activeP = getActivePlayer();
                if (activeP && typeof activeP.getDuration === "function") {
                    dur = activeP.getDuration() || 0;
                    if (dur > 0 && typeof activeP.seekTo === "function") {
                        activeP.seekTo(pct * dur, true);
                    }
                }
            }
            updateProgressUI(pct * dur, dur);
        }

        function formatTime(sec) {
            if (isNaN(sec) || sec < 0) return "0:00";
            const m = Math.floor(sec / 60);
            const s = Math.floor(sec % 60);
            return `${m}:${s < 10 ? "0" : ""}${s}`;
        }

        function updateProgressUI(curr, dur) {
            const fill = document.getElementById("progressFill");
            const scrubber = document.getElementById("progressScrubber");
            const curLabel = document.getElementById("timeCurrent");
            const durLabel = document.getElementById("timeDuration");

            if (curLabel) curLabel.textContent = formatTime(curr);
            if (durLabel) durLabel.textContent = formatTime(dur);

            if (dur > 0) {
                const pct = Math.max(0, Math.min(100, (curr / dur) * 100));
                if (fill) fill.style.width = `${pct}%`;
                if (scrubber) scrubber.style.left = `${pct}%`;
            } else {
                if (fill) fill.style.width = "0%";
                if (scrubber) scrubber.style.left = "0%";
            }
        }

        // CONTROLE MASTER DE VOLUME (0 a 200% VLC) & PERSISTÊNCIA
        function setMasterVolume(val) {
            masterVolume = parseInt(val, 10);
            if (isNaN(masterVolume)) masterVolume = 100;
            masterVolume = Math.max(0, Math.min(200, masterVolume));

            isMuted = (masterVolume === 0);
            if (masterVolume > 0) prevMasterVolume = masterVolume;

            localStorage.setItem("pref_masterVolume", masterVolume.toString());
            updateVolumeUI();

            // Aplica no Web Audio HD (0.0 até 2.0 = 200% VLC)
            if (masterGainNode && audioCtx) {
                const targetGain = isMuted ? 0.0 : (masterVolume / 100);
                masterGainNode.gain.setTargetAtTime(targetGain, audioCtx.currentTime, 0.02);
            }

            // Se o YouTube IFrame estiver ativo, aplica com limite de 100
            if (!isTransitioning) {
                const activeP = getActivePlayer();
                if (activeP && typeof activeP.setVolume === "function") {
                    try {
                        if (isMuted) {
                            activeP.mute();
                        } else {
                            activeP.unMute();
                            activeP.setVolume(Math.min(100, masterVolume));
                        }
                    } catch (e) {}
                }
            }
        }

        function cycleVlcBoost() {
            if (masterVolume < 100) setMasterVolume(100);
            else if (masterVolume === 100) setMasterVolume(125);
            else if (masterVolume === 125) setMasterVolume(150);
            else if (masterVolume === 150) setMasterVolume(200);
            else setMasterVolume(100);
            showToast(`Volume VLC: ${masterVolume}%`);
        }

        function toggleMute() {
            if (masterVolume > 0) {
                prevMasterVolume = masterVolume;
                setMasterVolume(0);
            } else {
                setMasterVolume(prevMasterVolume > 0 ? prevMasterVolume : 100);
            }
        }

        function updateVolumeUI() {
            const slider = document.getElementById("volumeSlider");
            const text = document.getElementById("volText");
            const barMute = document.getElementById("barMuteBtn");
            const eqSlider = document.getElementById("eqVolumeSlider");
            const eqText = document.getElementById("eqBoostText");

            let volLabel = `${masterVolume}%`;
            let volColor = "var(--text-dim)";
            if (masterVolume > 140) {
                volLabel = `🔥 ${masterVolume}%`;
                volColor = "#ff0055";
            } else if (masterVolume > 100) {
                volLabel = `⚡ ${masterVolume}%`;
                volColor = "#ffaa00";
            }

            const icon = (isMuted || masterVolume === 0) ? "🔇" : (masterVolume < 50 ? "🔉" : (masterVolume <= 100 ? "🔊" : "📢"));

            if (slider) slider.value = masterVolume;
            if (text) {
                text.textContent = volLabel;
                text.style.color = volColor;
            }
            if (barMute) barMute.textContent = icon;

            if (eqSlider) eqSlider.value = masterVolume;
            if (eqText) {
                eqText.textContent = volLabel;
                eqText.style.color = volColor;
            }

            // Atualiza a tag indicadora de status e volume no Player do YouTube
            const visTag = document.getElementById("visTagText");
            if (visTag) {
                if (isMuted || masterVolume === 0) {
                    visTag.textContent = engineMode === "audio" ? "ÁUDIO HD • 🔇 MUDO" : "CLIPE YT • 🔇 MUDO";
                } else {
                    const modePrefix = engineMode === "audio" ? "ÁUDIO HD" : "CLIPE YT";
                    const vlcExtra = masterVolume > 100 ? " VLC" : "";
                    visTag.textContent = `${modePrefix} • ${masterVolume}%${vlcExtra}`;
                }
            }
        }

        // CONTROLE DO EQUALIZADOR SPOTIFY
        function selectEqPreset(presetKey) {
            currentEqPreset = presetKey;
            localStorage.setItem("pref_eq_preset", presetKey);
            const preset = EQ_PRESETS[presetKey] || EQ_PRESETS["grave"];

            Object.keys(EQ_PRESETS).forEach(k => {
                const card = document.getElementById(`eqCard_${k}`);
                if (card) card.className = `eq-preset-card ${k === presetKey ? "active" : ""}`;
            });

            const barEqLabel = document.getElementById("barEqLabel");
            if (barEqLabel) barEqLabel.textContent = `${preset.name}`;

            const freqs = [60, 230, 910, 3600, 14000];
            freqs.forEach((f, idx) => {
                const s = document.getElementById(`eqSlider_${f}`);
                const l = document.getElementById(`eqVal_${f}`);
                const g = preset.gains[idx] || 0;
                if (s) s.value = g;
                if (l) l.textContent = (g > 0 ? `+${g}` : `${g}`) + " dB";
                if (eqFilters[idx] && audioCtx) {
                    eqFilters[idx].gain.setTargetAtTime(g, audioCtx.currentTime, 0.05);
                }
            });
        }

        function onCustomEqChange(index, val) {
            val = parseFloat(val);
            const freqs = [60, 230, 910, 3600, 14000];
            const f = freqs[index];
            const l = document.getElementById(`eqVal_${f}`);
            if (l) l.textContent = (val > 0 ? `+${val}` : `${val}`) + " dB";
            if (eqFilters[index] && audioCtx) {
                eqFilters[index].gain.setTargetAtTime(val, audioCtx.currentTime, 0.05);
            }
        }

        function openEqualizerModal() {
            const m = document.getElementById("equalizerModal");
            if (m) m.style.display = "flex";
            selectEqPreset(currentEqPreset);
            updateVolumeUI();
        }

        function closeEqualizerModal(e) {
            if (e && e.target && e.target.id !== "equalizerModal") return;
            const m = document.getElementById("equalizerModal");
            if (m) m.style.display = "none";
        }

        // Alternar Play / Pause
        function togglePlayPause() {
            initWebAudio();
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }

            if (engineMode === "audio") {
                const curAudio = getActiveAudioDeck();
                if (!curAudio) return;
                if (curAudio.paused) {
                    curAudio.play();
                    updatePlayPauseButtons(true);
                } else {
                    curAudio.pause();
                    updatePlayPauseButtons(false);
                }
            } else {
                const activeP = getActivePlayer();
                if (!activeP || typeof activeP.getPlayerState !== "function") return;
                const state = activeP.getPlayerState();
                if (state === YT.PlayerState.PLAYING) {
                    activeP.pauseVideo();
                    updatePlayPauseButtons(false);
                } else {
                    activeP.playVideo();
                    updatePlayPauseButtons(true);
                }
            }
        }

        function updatePlayPauseButtons(isPlaying) {
            const barBtn = document.getElementById("barPlayBtn");
            const text = isPlaying ? "⏸" : "▶";
            if (barBtn) barBtn.textContent = text;
        }

        // Avanço automático com crossfade
        function autoAdvanceWithFade() {
            let nextTrack = null;
            if (pendingQueue.length > 0) {
                nextTrack = pendingQueue.shift();
                saveQueue(pendingQueue);
                loadQueue();
            } else if (nowPlayingQueue.length > 0) {
                if (isShuffleEnabled) {
                    nowPlayingIndex = Math.floor(Math.random() * nowPlayingQueue.length);
                } else {
                    nowPlayingIndex = (nowPlayingIndex + 1) % nowPlayingQueue.length;
                }
                nextTrack = nowPlayingQueue[nowPlayingIndex];
            }

            if (nextTrack) {
                triggerCrossfade(nextTrack);
            }
        }

        // Transição Manual
        function manualTransition(dir) {
            if (nowPlayingQueue.length === 0) return;
            if (dir === "next") {
                if (isShuffleEnabled) {
                    nowPlayingIndex = Math.floor(Math.random() * nowPlayingQueue.length);
                } else {
                    nowPlayingIndex = (nowPlayingIndex + 1) % nowPlayingQueue.length;
                }
            } else {
                nowPlayingIndex = (nowPlayingIndex - 1 + nowPlayingQueue.length) % nowPlayingQueue.length;
            }
            const nextTrack = nowPlayingQueue[nowPlayingIndex];
            if (crossfadeSeconds > 0) {
                triggerCrossfade(nextTrack);
            } else {
                playTrackInstant(nextTrack);
            }
            renderAllActiveLists();
        }

        // Monitor de tempo para crossfade antecipado & atualização da seek bar
        function startTimeMonitor() {
            if (timeMonitorInterval) clearInterval(timeMonitorInterval);
            timeMonitorInterval = setInterval(() => {
                if (isTransitioning) return;

                let curr = 0;
                let dur = 0;

                if (engineMode === "audio") {
                    const curAudio = getActiveAudioDeck();
                    if (curAudio && !curAudio.paused) {
                        curr = curAudio.currentTime || 0;
                        dur = curAudio.duration || 0;
                    }
                } else {
                    const activeP = getActivePlayer();
                    if (activeP && typeof activeP.getCurrentTime === "function" && typeof activeP.getDuration === "function") {
                        try {
                            curr = activeP.getCurrentTime() || 0;
                            dur = activeP.getDuration() || 0;
                        } catch (e) {}
                    }
                }

                updateProgressUI(curr, dur);

                if (dur >= 25 && curr >= 12 && crossfadeSeconds > 0) {
                    const remaining = dur - curr;
                    if (remaining <= crossfadeSeconds && !hasFadedCurrentTrack && isAutoPlayEnabled) {
                        hasFadedCurrentTrack = true;
                        autoAdvanceWithFade();
                    }
                }
            }, 400);
        }

        function toggleCrossfadeSetting() {
            if (crossfadeSeconds === 0) crossfadeSeconds = 2;
            else if (crossfadeSeconds === 2) crossfadeSeconds = 4;
            else if (crossfadeSeconds === 4) crossfadeSeconds = 6;
            else if (crossfadeSeconds === 6) crossfadeSeconds = 8;
            else crossfadeSeconds = 0;

            localStorage.setItem("pref_crossfadeSeconds", crossfadeSeconds.toString());
            updateSettingsUI();
            showToast(crossfadeSeconds === 0 ? "Fade desligado" : `Fade configurado para ${crossfadeSeconds}s`);
        }

        function toggleIntroSkip() {
            if (introSkipSeconds === 0) introSkipSeconds = 1.5;
            else if (introSkipSeconds === 1.5) introSkipSeconds = 2.0;
            else if (introSkipSeconds === 2.0) introSkipSeconds = 3.0;
            else introSkipSeconds = 0;

            localStorage.setItem("pref_introSkipSeconds", introSkipSeconds.toString());
            updateSettingsUI();
            showToast(introSkipSeconds === 0 ? "Pulo de silêncio desativado" : `Pulo de silêncio inicial: ${introSkipSeconds}s`);
        }

        function toggleAutoPlay() {
            isAutoPlayEnabled = !isAutoPlayEnabled;
            localStorage.setItem("pref_autoPlay", isAutoPlayEnabled.toString());
            updateSettingsUI();
            showToast(isAutoPlayEnabled ? "Autoplay ativado" : "Autoplay pausado");
        }

        function toggleShuffle() {
            isShuffleEnabled = !isShuffleEnabled;
            localStorage.setItem("pref_shuffle", isShuffleEnabled.toString());
            updateSettingsUI();
            updateUpcomingTrackUI();
            renderList();
            showToast(isShuffleEnabled ? "Modo aleatório ativado" : "Ordem normal ativada");
        }

        function updateSettingsUI() {
            const btnCross = document.getElementById("barCrossfadeBtn");
            if (btnCross) {
                btnCross.innerHTML = `🎚️ Fade: ${crossfadeSeconds}s`;
                btnCross.className = `bar-pill-btn ${crossfadeSeconds > 0 ? "fade-active" : ""}`;
            }

            const btnIntro = document.getElementById("barIntroSkipBtn");
            if (btnIntro) {
                btnIntro.innerHTML = `⚡ Silêncio: ${introSkipSeconds}s`;
                btnIntro.className = `bar-pill-btn ${introSkipSeconds > 0 ? "active" : ""}`;
            }

            const btnAuto = document.getElementById("barAutoPlayBtn");
            if (btnAuto) {
                btnAuto.className = `bar-pill-btn ${isAutoPlayEnabled ? "active" : ""}`;
            }

            const btnShuff = document.getElementById("barShuffleBtn");
            if (btnShuff) {
                btnShuff.className = `bar-pill-btn ${isShuffleEnabled ? "active" : ""}`;
            }

            const btnMode = document.getElementById("barEngineModeBtn");
            if (btnMode) {
                btnMode.innerHTML = engineMode === "audio" ? "🎵 Áudio HD" : "🎬 Clipe";
                btnMode.className = `bar-pill-btn ${engineMode === "audio" ? "active" : ""}`;
            }
        }

        function updateTrackInfoUI(track) {
            if (!track) return;
            const tTitle = document.getElementById("trackTitle");
            const tArtist = document.getElementById("trackArtist");
            const tSource = document.getElementById("trackSource");
            const bTitle = document.getElementById("barTitle");
            const bArtist = document.getElementById("barArtist");
            const bThumb = document.getElementById("barThumb");

            const visArt = document.getElementById("visAlbumArt");
            const visBlur = document.getElementById("visBgBlur");

            const thumbUrl = `https://img.youtube.com/vi/${track.video_id}/hqdefault.jpg`;

            if (tTitle) tTitle.textContent = track.title;
            if (tArtist) tArtist.textContent = track.artist || track.category || "";
            if (tSource) tSource.textContent = track.source || nowPlayingCategoryName;
            if (bTitle) bTitle.textContent = track.title;
            if (bArtist) bArtist.textContent = track.artist || track.category || "";
            if (bThumb) bThumb.src = thumbUrl;

            if (visArt) visArt.src = thumbUrl;
            if (visBlur) visBlur.style.backgroundImage = `url('${thumbUrl}')`;

            const btnYt = document.getElementById("btnYt");
            if (btnYt) btnYt.href = `https://www.youtube.com/watch?v=${track.video_id}`;
            const btnYtMusic = document.getElementById("btnYtMusic");
            if (btnYtMusic) btnYtMusic.href = `https://music.youtube.com/watch?v=${track.video_id}`;

            updateUpcomingTrackUI();
        }

        function showToast(msg) {
            const t = document.getElementById("toastNotify");
            if (!t) return;
            t.textContent = msg;
            t.style.display = "block";
            setTimeout(() => {
                t.style.display = "none";
            }, 3500);
        }

        function hideToast() {
            const t = document.getElementById("toastNotify");
            if (t) t.style.display = "none";
        }

        function showCrossfadeIndicator() {
            const ind = document.getElementById("crossfadeIndicator");
            if (ind) ind.style.display = "block";
        }

        function hideCrossfadeIndicator() {
            const ind = document.getElementById("crossfadeIndicator");
            if (ind) ind.style.display = "none";
        }

        // Busca com Debounce na Biblioteca
        function handleLibrarySearch(query) {
            if (searchDebounceTimer) clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                executeLibrarySearch(query);
            }, 120);
        }

        function clearLibrarySearch() {
            const input = document.getElementById("searchInput");
            if (input) input.value = "";
            executeLibrarySearch("");
        }

        function removeAccents(str) {
            return (str || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
        }

        function escapeHtml(str) {
            return (str || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function executeLibrarySearch(query) {
            const rawQ = (query || "").trim();
            const q = removeAccents(rawQ);
            const clearBtn = document.getElementById("btnClearSearch");
            const badge = document.getElementById("searchBadgeCount");
            const listContainer = document.getElementById("trackList");

            if (!rawQ) {
                if (clearBtn) clearBtn.style.display = "none";
                if (badge) badge.textContent = "";
                renderList(DATA[browseCategory] || []);
                return;
            }

            if (clearBtn) clearBtn.style.display = "block";

            // Busca em TODA a biblioteca completa (todas as 725+ faixas)
            const allTracks = [];
            const seenIds = new Set();
            CATEGORIES.forEach(cat => {
                (DATA[cat] || []).forEach(t => {
                    if (!seenIds.has(t.video_id)) {
                        seenIds.add(t.video_id);
                        allTracks.push(t);
                    }
                });
            });

            const queryWords = q.split(/\s+/).filter(w => w.length > 0);

            const filtered = allTracks.filter(t => {
                const titleNorm = removeAccents(t.title);
                const artistNorm = removeAccents(t.artist);
                const catNorm = removeAccents(t.category);
                const bpmStr = (t.bpm || "").toString();

                return queryWords.every(word => 
                    titleNorm.includes(word) || 
                    artistNorm.includes(word) || 
                    catNorm.includes(word) ||
                    bpmStr === word ||
                    (word.endsWith("bpm") && bpmStr === word.replace("bpm", ""))
                );
            });

            if (badge) {
                badge.textContent = `${filtered.length} na biblioteca`;
            }

            if (filtered.length > 0) {
                renderList(filtered);
            } else {
                listContainer.innerHTML = `
                    <div style="background: rgba(255, 255, 255, 0.03); border: 1px dashed rgba(255, 255, 255, 0.15); border-radius: 12px; padding: 30px 20px; text-align: center; margin-top: 15px;">
                        <div style="font-size: 32px; margin-bottom: 10px;">🔍</div>
                        <div style="font-size: 14px; font-weight: 700; color: #fff; margin-bottom: 6px;">
                            Nenhuma música com "<em>${escapeHtml(rawQ)}</em>" na sua biblioteca
                        </div>
                        <div style="font-size: 12px; color: var(--text-dim); margin-bottom: 18px;">
                            Quer que a IA busque novas músicas com esse nome, ritmo ou artista no YouTube?
                        </div>
                        <button class="btn-sync-yt" onclick="searchExternalYouTube('${escapeQuotes(rawQ)}')" style="display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, #ff0055, #ff5500); padding: 10px 22px; font-size: 13px; font-weight: 800; border-radius: 24px; box-shadow: 0 4px 15px rgba(255, 0, 85, 0.4); margin: 0 auto;">
                            <span>✨ Buscar "${escapeHtml(rawQ)}" no YouTube com IA</span>
                        </button>
                    </div>
                `;
            }
        }

        function searchExternalYouTube(query) {
            switchView("suggestions");
            const input = document.getElementById("suggSearchInput");
            if (input) input.value = query;
            executeCustomSuggestionSearch(query);
        }

        async function executeCustomSuggestionSearch(query) {
            const q = (query || "").trim();
            if (!q) return;
            const container = document.getElementById("suggestionsList");
            const badge = document.getElementById("suggestionCountBadge");
            const titleEl = document.getElementById("suggestionActiveGenreTitle");
            const subEl = document.getElementById("suggestionSubtext");

            if (badge) badge.textContent = "Buscando com IA...";
            if (titleEl) titleEl.innerHTML = `🔍 Busca com IA: <em>${escapeHtml(q)}</em>`;
            if (subEl) subEl.innerHTML = `Buscando novidades no YouTube baseadas no ritmo, BPM e estilo de <strong>${escapeHtml(q)}</strong>.`;
            showSuggestionsSkeleton();

            try {
                const res = await fetch("/api/search", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ query: q, category: currentSuggestionCategory })
                });
                const data = await res.json();
                const tracks = data.tracks || (Array.isArray(data) ? data : []);

                renderSuggestionsList(tracks);
                if (badge) badge.textContent = `${tracks.length} encontradas`;
            } catch (e) {
                if (container) container.innerHTML = `<div style="color: #ff5555; text-align: center; padding: 25px;">Erro ao buscar novidades no YouTube. Tente novamente.</div>`;
            }
        }

        function escapeQuotes(str) {
            return (str || "").replace(/'/g, "\\'").replace(/"/g, '&quot;');
        }

        function openDirectQueueUrl() {
            if (pendingQueue.length === 0) return;
            const ids = pendingQueue.map(t => t.video_id).filter(Boolean).slice(0, 50).join(",");
            window.open(`https://www.youtube.com/watch_videos?video_ids=${ids}`, "_blank");
        }

        function updateQueueButton() {
            const tracks = DATA[browseCategory] || [];
            if (tracks.length === 0) return;
            const ids = tracks.map(t => t.video_id).filter(Boolean).slice(0, 50).join(",");
            const btn = document.getElementById("btnQueue");
            if (btn) btn.href = `https://www.youtube.com/watch_videos?video_ids=${ids}`;
        }

        // Gerenciamento da Fila de Reprodução
        async function loadQueue() {
            try {
                const res = await fetch("/api/queue");
                pendingQueue = await res.json();
                renderQueueList();
                const badge = document.getElementById("queueBadgeCount");
                if (badge) badge.textContent = pendingQueue.length;
                const paneBadge = document.getElementById("queueCountBadge");
                if (paneBadge) paneBadge.textContent = `${pendingQueue.length} músicas`;
                updateUpcomingTrackUI();
            } catch (e) {}
        }

        async function saveQueue(queue) {
            pendingQueue = queue;
            const badge = document.getElementById("queueBadgeCount");
            if (badge) badge.textContent = pendingQueue.length;
            const paneBadge = document.getElementById("queueCountBadge");
            if (paneBadge) paneBadge.textContent = `${pendingQueue.length} músicas`;
            updateUpcomingTrackUI();
        }

        async function addToQueue(track) {
            try {
                const res = await fetch("/api/queue/add", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(track)
                });
                const data = await res.json();
                if (data.queue) {
                    pendingQueue = data.queue;
                    loadQueue();
                    renderList();
                    showToast(`"${track.title}" adicionada à fila!`);
                }
            } catch (e) {}
        }

        async function removeFromQueue(videoId) {
            try {
                const res = await fetch("/api/queue/remove", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ video_id: videoId })
                });
                const data = await res.json();
                if (data.queue) {
                    pendingQueue = data.queue;
                    loadQueue();
                    renderList();
                }
            } catch (e) {}
        }

        async function clearAllQueue() {
            if (confirm("Deseja realmente limpar toda a sua fila?")) {
                try {
                    await fetch("/api/queue/clear", { method: "POST" });
                    loadQueue();
                    renderList();
                    showToast("Fila limpa com sucesso!");
                } catch (e) {}
            }
        }

        function renderQueueList() {
            const container = document.getElementById("queueList");
            if (!container) return;
            container.innerHTML = "";
            if (pendingQueue.length === 0) {
                container.innerHTML = '<div style="color: var(--text-dim); text-align: center; padding: 25px;">Sua fila está vazia. Adicione músicas para tocar!</div>';
                return;
            }

            pendingQueue.forEach((item, idx) => {
                const isNext = (idx === 0);
                const card = document.createElement("div");
                card.className = `track-card ${isNext ? "next-up" : ""}`;
                card.innerHTML = `
                    <div class="track-meta" onclick="playCustomTrack('${item.video_id}', '${escapeQuotes(item.title)}', '${escapeQuotes(item.artist)}', '${escapeQuotes(item.category)}', 'Fila')">
                        <div class="track-card-title">
                            <span>${idx + 1}. ${item.title}</span>
                            ${isNext ? `<div class="badge-next-up"><span>⏭️ A SEGUIR</span></div>` : ""}
                        </div>
                        <div class="track-card-artist">${item.artist || item.category}</div>
                    </div>
                    <div class="card-actions">
                        <button class="btn-add-queue" onclick="removeFromQueue('${item.video_id}')">Remover</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        let currentActiveSuggestions = [];

        // Renderiza lista de sugestões com badges ao vivo (TOCANDO AGORA, A SEGUIR, ADICIONADA AGORA) e todas as ferramentas
        function renderSuggestionsList(tracks) {
            currentActiveSuggestions = tracks || [];
            const container = document.getElementById("suggestionsList");
            if (!container) return;
            container.innerHTML = "";
            if (!tracks || tracks.length === 0) {
                container.innerHTML = '<div style="color: var(--text-dim); text-align: center; padding: 25px;">Nenhuma sugestão encontrada no momento.</div>';
                return;
            }

            const currentVideoId = nowPlayingTrack ? nowPlayingTrack.video_id : null;
            const upcomingTrack = getUpcomingTrack();
            const upcomingVideoId = upcomingTrack ? upcomingTrack.video_id : null;
            const queuedIds = new Set(pendingQueue.map(t => t.video_id));

            tracks.forEach((item, idx) => {
                const isQueued = queuedIds.has(item.video_id);
                const isPlaying = (item.video_id === currentVideoId);
                const isLastAdded = (!isPlaying && (item.video_id === lastAddedVideoId || item.addedJustNow));
                const isNext = (!isPlaying && !isLastAdded && item.video_id === upcomingVideoId);

                let cardClasses = "track-card";
                if (isPlaying) cardClasses += " playing-now";
                else if (isNext) cardClasses += " next-up";
                else if (isLastAdded) cardClasses += " next-up";

                let statusBadgeHtml = "";
                if (isPlaying) {
                    statusBadgeHtml = `
                        <div class="badge-now-playing">
                            <span class="eq-anim-bars"><span></span><span></span><span></span></span>
                            <span>TOCANDO AGORA</span>
                        </div>
                    `;
                } else if (isLastAdded) {
                    statusBadgeHtml = `
                        <div class="badge-added-now">
                            <span>✨ ADICIONADA AGORA</span>
                        </div>
                    `;
                } else if (isNext) {
                    statusBadgeHtml = `
                        <div class="badge-next-up">
                            <span>⏭️ A SEGUIR (PRÓXIMA)</span>
                        </div>
                    `;
                }

                const bpm = item.bpm || detectBpmJs(item.title, item.category);
                const bpmBadgeHtml = `<span class="badge-bpm-chip">⚡ ${bpm} BPM</span>`;
                const catBadgeHtml = item.category ? `<span class="badge-bpm-chip" style="background: rgba(0,242,254,0.1); border-color: rgba(0,242,254,0.3); color: var(--accent);">🏷️ ${item.category}</span>` : "";

                const card = document.createElement("div");
                card.id = `suggCard_${item.video_id}`;
                card.className = cardClasses;
                card.innerHTML = `
                    <div class="track-meta" onclick="playCustomTrack('${item.video_id}', '${escapeQuotes(item.title)}', '${escapeQuotes(item.artist)}', '${escapeQuotes(item.category)}', 'Sugestões', ${bpm})">
                        <div class="track-card-title">
                            <span>${idx + 1}. ${item.title}</span>
                            ${statusBadgeHtml}
                        </div>
                        <div class="track-card-artist">
                            <span>${item.artist || item.category}</span>
                            <div style="display: flex; gap: 5px; margin-top: 3px; align-items: center; flex-wrap: wrap;">
                                ${bpmBadgeHtml}
                                ${catBadgeHtml}
                            </div>
                        </div>
                    </div>
                    <div class="card-actions">
                        <button class="btn-similar-card" onclick="findSimilarToTrack(${JSON.stringify(item).replace(/"/g, '&quot;')})" title="Buscar músicas semelhantes no mesmo ritmo e BPM com IA">
                            📻 Parecidas
                        </button>
                        <button class="btn-add-playlist" onclick="addTrackToPlaylist(${JSON.stringify(item).replace(/"/g, '&quot;')}, document.getElementById('suggCard_${item.video_id}'))" title="Salvar permanentemente na sua Playlist/Biblioteca">
                            ⭐ + Playlist
                        </button>
                        ${isQueued 
                            ? `<button class="btn-add-queue added">✓ Na Fila</button>`
                            : `<button class="btn-add-queue" onclick="addToQueue(${JSON.stringify(item).replace(/"/g, '&quot;')})">+ Fila</button>`
                        }
                    </div>
                `;
                container.appendChild(card);
            });
        }

        
        // ==========================================================
        // MÓDULO DE PESQUISA LIVRE (BIBLIOTECA COMPLETA + YOUTUBE IA)
        // ==========================================================
        let freeSearchResults = {
            library_tracks: [],
            youtube_tracks: [],
            tracks: []
        };
        let freeSearchFilter = "all"; // "all", "library", "new"
        let isSearchingFree = false;

        function goToFreeSearch(initialQuery) {
            switchView("search");
            const input = document.getElementById("freeSearchInput");
            if (input) {
                input.value = initialQuery || "";
                executeFreeSearch(initialQuery);
            }
        }

        function handleFreeSearchInput(query) {
            const btnClear = document.getElementById("btnFreeSearchClear");
            if (btnClear) btnClear.style.display = query ? "block" : "none";
            if (!query.trim()) {
                clearFreeSearch();
            }
        }

        function clearFreeSearch() {
            const input = document.getElementById("freeSearchInput");
            const btnClear = document.getElementById("btnFreeSearchClear");
            if (input) input.value = "";
            if (btnClear) btnClear.style.display = "none";
            freeSearchResults = { library_tracks: [], youtube_tracks: [], tracks: [] };
            renderSearchResults();
        }

        function quickBpmSearch(bpmOrStyle) {
            const input = document.getElementById("freeSearchInput");
            if (input) input.value = bpmOrStyle;
            executeFreeSearch(bpmOrStyle);
        }

        function setSearchFilter(filterType) {
            freeSearchFilter = filterType;
            const tabAll = document.getElementById("tabFilterAll");
            const tabLib = document.getElementById("tabFilterLib");
            const tabNew = document.getElementById("tabFilterNew");

            if (tabAll) tabAll.className = `filter-tab-btn ${filterType === "all" ? "active" : ""}`;
            if (tabLib) tabLib.className = `filter-tab-btn ${filterType === "library" ? "active" : ""}`;
            if (tabNew) tabNew.className = `filter-tab-btn ${filterType === "new" ? "active" : ""}`;

            renderSearchResults();
        }

        async function executeFreeSearch(query) {
            query = (query || "").trim();
            if (!query) return;

            isSearchingFree = true;
            const container = document.getElementById("searchResultsList");
            if (container) {
                container.innerHTML = `
                    <div class="search-empty-state">
                        <div class="search-empty-icon" style="animation: pulseDot 1s infinite;">🔍</div>
                        <div class="search-empty-title">Pesquisando "${query}"...</div>
                        <div class="search-empty-desc">Procurando na biblioteca e minerando novidades no YouTube com IA...</div>
                    </div>
                `;
            }

            try {
                const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                freeSearchResults = data;
                isSearchingFree = false;

                // Atualiza contadores dos filtros
                const cntAll = document.getElementById("countSearchAll");
                const cntLib = document.getElementById("countSearchLib");
                const cntNew = document.getElementById("countSearchNew");
                if (cntAll) cntAll.textContent = (data.tracks || []).length;
                if (cntLib) cntLib.textContent = (data.library_tracks || []).length;
                if (cntNew) cntNew.textContent = (data.youtube_tracks || []).length;

                renderSearchResults();
            } catch (err) {
                console.error("Erro na busca livre:", err);
                isSearchingFree = false;
                if (container) {
                    container.innerHTML = `
                        <div class="search-empty-state">
                            <div class="search-empty-icon" style="color: #ff5555;">⚠️</div>
                            <div class="search-empty-title">Erro ao buscar músicas</div>
                            <div class="search-empty-desc">Verifique a conexão com o servidor local e tente novamente.</div>
                        </div>
                    `;
                }
            }
        }

        function renderSearchResults() {
            const container = document.getElementById("searchResultsList");
            if (!container) return;
            if (isSearchingFree) return;

            let displayTracks = [];
            if (freeSearchFilter === "library") {
                displayTracks = freeSearchResults.library_tracks || [];
            } else if (freeSearchFilter === "new") {
                displayTracks = freeSearchResults.youtube_tracks || [];
            } else {
                displayTracks = freeSearchResults.tracks || [];
            }

            if (displayTracks.length === 0) {
                const hasSearched = (document.getElementById("freeSearchInput") && document.getElementById("freeSearchInput").value);
                container.innerHTML = `
                    <div class="search-empty-state">
                        <div class="search-empty-icon">${hasSearched ? "🔎" : "🔍"}</div>
                        <div class="search-empty-title">${hasSearched ? "Nenhuma música encontrada" : "Pesquisa Livre & Descobertas"}</div>
                        <div class="search-empty-desc">${hasSearched ? "Tente buscar por outro termo, nome de DJ, ritmo ou BPM." : "Digite qualquer música, ritmo ou BPM acima para buscar com IA e ouvir com Crossfade!"}</div>
                    </div>
                `;
                return;
            }

            container.innerHTML = "";
            const currentVideoId = nowPlayingTrack ? nowPlayingTrack.video_id : null;
            const upcomingTrack = getUpcomingTrack();
            const upcomingVideoId = upcomingTrack ? upcomingTrack.video_id : null;
            const queuedIds = new Set(pendingQueue.map(t => t.video_id));

            // Checagem de faixas existentes na biblioteca
            const libVideoIds = new Set();
            CATEGORIES.forEach(cat => {
                (DATA[cat] || []).forEach(t => { if (t.video_id) libVideoIds.add(t.video_id); });
            });

            displayTracks.forEach((item, idx) => {
                const isQueued = queuedIds.has(item.video_id);
                const isPlaying = (item.video_id === currentVideoId);
                const isLastAdded = (!isPlaying && (item.video_id === lastAddedVideoId || item.addedJustNow));
                const isNext = (!isPlaying && !isLastAdded && item.video_id === upcomingVideoId);
                const inLibrary = item.in_library || libVideoIds.has(item.video_id);

                let cardClasses = "track-card";
                if (isPlaying) cardClasses += " playing-now";
                else if (isNext) cardClasses += " next-up";
                else if (isLastAdded) cardClasses += " next-up";

                let statusBadgeHtml = "";
                if (isPlaying) {
                    statusBadgeHtml = `
                        <div class="badge-now-playing">
                            <span class="eq-anim-bars"><span></span><span></span><span></span></span>
                            <span>TOCANDO AGORA</span>
                        </div>
                    `;
                } else if (isLastAdded) {
                    statusBadgeHtml = `
                        <div class="badge-added-now">
                            <span>✨ ADICIONADA AGORA</span>
                        </div>
                    `;
                } else if (isNext) {
                    statusBadgeHtml = `
                        <div class="badge-next-up">
                            <span>⏭️ A SEGUIR (PRÓXIMA)</span>
                        </div>
                    `;
                }

                const bpm = item.bpm || detectBpmJs(item.title, item.category);
                const bpmBadgeHtml = `<span class="badge-bpm-chip">⚡ ${bpm} BPM</span>`;
                const catBadgeHtml = item.category ? `<span class="badge-bpm-chip" style="background: rgba(0,242,254,0.1); border-color: rgba(0,242,254,0.3); color: var(--accent);">🏷️ ${item.category}</span>` : "";
                const sourceBadge = inLibrary 
                    ? `<span class="badge-source" style="background: rgba(0, 230, 118, 0.15); color: #00e676; border: 1px solid rgba(0, 230, 118, 0.3);">✓ Na Biblioteca</span>`
                    : `<span class="badge-source" style="background: rgba(0, 242, 254, 0.15); color: var(--accent);">✨ YouTube Novidade</span>`;

                const card = document.createElement("div");
                card.id = `searchCard_${item.video_id}`;
                card.className = cardClasses;
                card.innerHTML = `
                    <div class="track-meta" onclick="playCustomTrack('${item.video_id}', '${escapeQuotes(item.title)}', '${escapeQuotes(item.artist)}', '${escapeQuotes(item.category)}', 'Busca', ${bpm})">
                        <div class="track-card-title">
                            <span>${idx + 1}. ${item.title}</span>
                            ${statusBadgeHtml}
                        </div>
                        <div class="track-card-artist">
                            <span>${item.artist || item.category}</span>
                            <div style="display: flex; gap: 5px; margin-top: 3px; align-items: center; flex-wrap: wrap;">
                                ${bpmBadgeHtml}
                                ${catBadgeHtml}
                                ${sourceBadge}
                            </div>
                        </div>
                    </div>
                    <div class="card-actions">
                        <button class="btn-similar-card" onclick="findSimilarToTrack(${JSON.stringify(item).replace(/"/g, '&quot;')})" title="Buscar músicas semelhantes no mesmo ritmo e BPM com IA">
                            📻 Parecidas
                        </button>
                        ${inLibrary 
                            ? `<button class="btn-add-playlist" style="background: rgba(0, 230, 118, 0.15); border-color: rgba(0, 230, 118, 0.4); color: #00e676;" title="Esta música já está salva na sua biblioteca">❤️ Na Playlist</button>`
                            : `<button class="btn-add-playlist" onclick="addTrackToPlaylist(${JSON.stringify(item).replace(/"/g, '&quot;')}, document.getElementById('searchCard_${item.video_id}'))" title="Salvar permanentemente na sua Playlist/Biblioteca">⭐ Favoritar</button>`
                        }
                        ${isQueued 
                            ? `<button class="btn-add-queue added">✓ Na Fila</button>`
                            : `<button class="btn-add-queue" onclick="addToQueue(${JSON.stringify(item).replace(/"/g, '&quot;')})">+ Fila</button>`
                        }
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // ==========================================================
        // ATUALIZAÇÃO SINCRONIZADA DE TODAS AS TELAS ATIVAS
        // ==========================================================
        function renderAllActiveLists() {
            renderList();
            if (browseView === "suggestions" && currentActiveSuggestions.length > 0) {
                renderSuggestionsList(currentActiveSuggestions);
            }
            if (browseView === "search") {
                renderSearchResults();
            }
            if (browseView === "queue") {
                loadQueue();
            }
            updateUpcomingTrackUI();
            updateDjMixerUI();
        }

        // ==========================================================
        // EFEITO RIPPLE E PULSO AO CLICAR EM QUALQUER ELEMENTO/BOTÃO
        // ==========================================================
        document.addEventListener("click", function(e) {
            const target = e.target.closest("button, .btn-action, .bar-btn, .bar-pill-btn, .btn-dj-mix, .btn-radio-now, .vlc-chip-btn, .nav-btn, .category-tab, .floating-sync-btn, .chip-bpm, .filter-tab-btn");
            if (!target) return;

            const rect = target.getBoundingClientRect();
            const ripple = document.createElement("span");
            ripple.className = "click-ripple-effect";
            const size = Math.max(rect.width, rect.height);
            ripple.style.width = ripple.style.height = `${size}px`;
            ripple.style.left = `${e.clientX - rect.left - size / 2}px`;
            ripple.style.top = `${e.clientY - rect.top - size / 2}px`;

            const prevPos = window.getComputedStyle(target).position;
            if (prevPos === "static") target.style.position = "relative";
            target.appendChild(ripple);

            setTimeout(() => {
                ripple.remove();
            }, 450);
        }, true);


        // YouTube IFrame API Callback
        function onYouTubeIframeAPIReady() {
            const initialId = nowPlayingTrack ? nowPlayingTrack.video_id : "u3IErhAXL3w";
            const secondId = (nowPlayingQueue.length > 1) ? nowPlayingQueue[1].video_id : initialId;
            const startSec = Math.max(0, parseFloat(introSkipSeconds) || 0);

            playerA = new YT.Player("deckA", {
                height: "100%",
                width: "100%",
                videoId: initialId,
                playerVars: {
                    "autoplay": 0,
                    "start": Math.round(startSec),
                    "rel": 0,
                    "modestbranding": 1,
                    "enablejsapi": 1
                },
                events: {
                    "onReady": (e) => {
                        isPlayerAReady = true;
                        updateVolumeUI();
                        updateSettingsUI();
                        if (nowPlayingTrack) {
                            updateTrackInfoUI(nowPlayingTrack);
                        }
                        loadQueue();
                    },
                    "onStateChange": (e) => onDeckStateChange(e, "A"),
                    "onError": (e) => onDeckError(e, "A")
                }
            });

            playerB = new YT.Player("deckB", {
                height: "100%",
                width: "100%",
                videoId: secondId,
                playerVars: {
                    "autoplay": 0,
                    "start": Math.round(startSec),
                    "rel": 0,
                    "modestbranding": 1,
                    "enablejsapi": 1
                },
                events: {
                    "onReady": (e) => {
                        isPlayerBReady = true;
                        try {
                            playerB.pauseVideo();
                            playerB.setVolume(0);
                        } catch (err) {}
                    },
                    "onStateChange": (e) => onDeckStateChange(e, "B"),
                    "onError": (e) => onDeckError(e, "B")
                }
            });
        }

        function onDeckStateChange(event, deckName) {
            if (engineMode !== "video") return;
            if (deckName === activeDeck && !isTransitioning) {
                if (event.data === YT.PlayerState.PLAYING) {
                    updatePlayPauseButtons(true);
                    hideToast();
                } else if (event.data === YT.PlayerState.PAUSED) {
                    updatePlayPauseButtons(false);
                } else if (event.data === YT.PlayerState.ENDED) {
                    if (isAutoPlayEnabled && !hasFadedCurrentTrack) {
                        hasFadedCurrentTrack = true;
                        autoAdvanceWithFade();
                    }
                }
            }
        }

        // Tratamento de restrição de gravadora no YouTube:
        // NÃO PULA A MÚSICA! Em vez de pular, ativa o Áudio HD automaticamente sem interrupção!
        function onDeckError(event, deckName) {
            if (deckName !== activeDeck) return;
            const code = event ? event.data : null;
            console.warn("YouTube Player event error code:", code);
            
            if (code === 150 || code === 101 || code === 100 || code === 2 || code === 5) {
                showToast("🎵 Vídeo bloqueado no YouTube por direitos autorais. Ativando Áudio HD sem restrições!");
                setEngineMode("audio");
            }
        }

        // Inicialização de UI
        initTabs();
        setupTabsAutoScroll("tabsWrapper", "tabsScrollLeft", "tabsScrollRight");
        setupTabsAutoScroll("suggestionsTabsWrapper", "suggScrollLeft", "suggScrollRight");
        setupListVerticalAutoScroll("trackList");
        setupListVerticalAutoScroll("suggestionsList");
        setupListVerticalAutoScroll("queueList");
        selectCategoryToBrowse("Mega Funk & Ritmadas");
        updateVolumeUI();
        updateSettingsUI();

        // Configuração inicial do modo de engine
        setEngineMode(engineMode);

        // Desbloqueia Web Audio no primeiro clique do usuário em qualquer lugar da tela
        document.addEventListener("click", () => {
            initWebAudio();
            if (audioCtx && audioCtx.state === "suspended") {
                audioCtx.resume();
            }
        }, { once: true });
    </script>
</body>
</html>